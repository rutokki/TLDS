<Window x:Class="TLDSDashBoard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TLDSDashBoard.Views"
        Title="TLDS 대시보드"
        Width="1440" Height="920" MinWidth="1080" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}">

    <Grid>

        <!-- 앱 셸: 사이드바 + 메인 콘텐츠 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <views:SidebarView Grid.Column="0"/>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <views:TopbarView Grid.Row="0"/>

                <!-- ScrollViewer로 감싸지 않음: 목록 페이지들은 DataGrid가 이 영역을 채우고 내부에서 스크롤해야 한다
                     ("*" 행은 ScrollViewer 안에서는 콘텐츠 크기로 줄어든다). GraphPageView는 레인 차트 콘텐츠가
                     창보다 클 수 있어서 대신 스스로 내부 스크롤한다. -->
                <Grid Grid.Row="1" Margin="28,22">
                    <views:TrainOccupancyView Visibility="{Binding IsOccupancyActive, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <views:TrackFaultListView Visibility="{Binding IsTrackFaultActive, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <views:LevelRecordListView Visibility="{Binding IsLevelRecordActive, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <views:TrackVoltageListView Visibility="{Binding IsTrackVoltageActive, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <views:GraphPageView Visibility="{Binding IsGraphActive, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <views:GraphDetailSearchView Visibility="{Binding IsGraphSearchActive, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- 오버레이 -->
        <views:DrillModalView/>
        <views:HourlyStatusModalView/>
        <views:ToastView/>

    </Grid>
</Window>

<Window x:Class="TLDSDashBoard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TLDSDashBoard.Views"
        Title="통합 검색 대시보드"
        Width="1440" Height="920" MinWidth="1080" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}">

    <Grid>

        <!-- App shell: sidebar + main content -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <views:SidebarView Grid.Column="0"/>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <views:TopbarView Grid.Row="0"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,22">
                        <views:KpiRowView/>
                        <views:MetricGroupView Data="{Binding TxChart}" Margin="0,20,0,0"/>
                        <views:MetricGroupView Data="{Binding RxChart}" Margin="0,20,0,0"/>
                        <views:AlarmLogView Margin="0,20,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Overlays -->
        <views:DrillModalView/>
        <views:ToastView/>

    </Grid>
</Window>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ 기본 배경 색상 ============ -->
    <Color x:Key="BgColor">#FF101319</Color>
    <Color x:Key="SidebarBgColor">#FF0E1116</Color>
    <Color x:Key="PanelBgColor">#FF181C22</Color>
    <Color x:Key="PanelHoverBgColor">#FF282C33</Color>
    <Color x:Key="BorderColor">#FF242931</Color>
    <Color x:Key="BorderLightColor">#FF2E333C</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="SidebarBgBrush" Color="{StaticResource SidebarBgColor}"/>
    <SolidColorBrush x:Key="PanelBgBrush" Color="{StaticResource PanelBgColor}"/>
    <SolidColorBrush x:Key="PanelHoverBgBrush" Color="{StaticResource PanelHoverBgColor}"/>
    <SolidColorBrush x:Key="BorderBrush1" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLightColor}"/>

    <!-- ============ 텍스트 색상 ============ -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFEEEFF1"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF8A8F98"/>
    <SolidColorBrush x:Key="TextDimBrush" Color="#FF6E737C"/>

    <!-- ============ 상태 색상 ============ -->
    <SolidColorBrush x:Key="CriticalBrush" Color="#FFD75B4A"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF3FBE8A"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FFE3AE4E"/>
    <SolidColorBrush x:Key="SuccessBgBrush" Color="#2E3FBE8A"/>

    <SolidColorBrush x:Key="CriticalTextBrush" Color="#FFE8836E"/>
    <SolidColorBrush x:Key="WarningTextBrush" Color="#FFEFC077"/>
    <SolidColorBrush x:Key="InfoTextBrush" Color="#FF82B4E8"/>

    <SolidColorBrush x:Key="CriticalBgBrush" Color="#2ED75B4A"/>
    <SolidColorBrush x:Key="WarningBgBrush" Color="#2EE3AE4E"/>
    <SolidColorBrush x:Key="InfoBgBrush" Color="#2E5B94D9"/>

    <!-- ============ 기타 반투명 면 ============ -->
    <SolidColorBrush x:Key="OverlayDimBrush" Color="#99000000"/>

    <SolidColorBrush x:Key="ExportBtnBgBrush" Color="#401E3A6E"/>
    <SolidColorBrush x:Key="ExportBtnBorderBrush" Color="#803D5A9E"/>
    <SolidColorBrush x:Key="ExportBtnTextBrush" Color="#FFA8BCE8"/>

    <!-- 주파수/전압 그래프 위의 점검/최소 기준선 오버레이 — 어두운 배경에서 기준선으로 분명히 읽히도록 일부러
         선명하고 채도 높게 잡았으며, 위의 부드러운 상태 색상과 구분된다. -->
    <SolidColorBrush x:Key="CheckedLineBrush" Color="#FFFFD740"/>
    <SolidColorBrush x:Key="MinimumLineBrush" Color="#FFFF5252"/>

</ResourceDictionary>

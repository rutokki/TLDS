<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono,Consolas,Consolas</FontFamily>

    <!-- 우리가 만든 ComboBox 템플릿(아래)이 닫힌 상자를 그리는 데 쓰는 SelectionBoxItemTemplate은 ItemTemplate에서만
         자동으로 채워지고 DisplayMemberPath에서는 채워지지 않는다 — DisplayMemberPath만 지정하면 닫힌 상자는
         항목의 ToString()으로 폴백한다. 그래서 Station/TrackCircuit(둘 다 Name을 가짐)에 바인딩하는 모든
         ComboBox는 DisplayMemberPath 대신 이 ItemTemplate을 쓴다. -->
    <DataTemplate x:Key="NameItemTemplate">
        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}"/>
    </DataTemplate>

    <!-- ===================== 기본 암시적 스타일 ===================== -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource PanelBgBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
    </Style>

    <!-- ===================== 어두운 ScrollBar ===================== -->
    <Style x:Key="DarkScrollBarThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{StaticResource BorderLightBrush}" CornerRadius="5" Margin="1"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 이 스타일은 예전에 Track에 Width=10을 하드코딩했는데, 세로 스크롤바의 두께로는 맞지만 가로 스크롤바에서는
         "Width"가 트랙의 길이라서 모든 가로 스크롤바가 10px짜리 조각으로 줄어들었다. DataGrid가 도입되기
         전에는 앱에 세로 ScrollViewer만 있어서 눈에 띄지 않았다. 이제는 방향을 인식한다: 두께는 세로면 Width,
         가로면 Height이고, Track 자체도 ScrollBar의 실제 Orientation을 따른다. -->
    <Style x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource DarkScrollBarThumb}"/>
                            </Track.Thumb>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Track" Property="Orientation" Value="Horizontal"/>
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="10"/>
                <Setter Property="MinWidth" Value="10"/>
            </Trigger>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="10"/>
                <Setter Property="MinHeight" Value="10"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== 카드 컨테이너 ===================== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush1}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>

    <Style x:Key="CardLarge" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="CornerRadius" Value="12"/>
    </Style>

    <!-- 클릭 가능한 카드(보조 지표 카드) -->
    <Style x:Key="ClickableCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== 텍스트 프리셋 ===================== -->
    <!-- 아래 키가 있는 TextBlock 스타일은 모두 암시적 TextBlock 스타일을 BasedOn으로 삼아 거기서
         Foreground=TextPrimaryBrush를 물려받는다 — 명시적인 Style="{StaticResource X}"는 암시적 스타일 위에 겹쳐지지
         않고 통째로 대체하므로, 여기서 BasedOn이 없으면 자체 Foreground를 지정하지 않은 스타일은 조용히 TextBlock의
         실제 기본값(검정)으로 돌아간다. SectionTitle/MonoValueBig/MonoValueMedium이 바로 그랬다: Foreground를 지정하지
         않고 물려받을 곳도 없어서 제목과 KPI 숫자가 검정으로 그려졌다. -->
    <Style x:Key="LabelUppercase" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Typography.Capitals" Value="AllSmallCaps"/>
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="MonoValueBig" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="MonoValueMedium" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="HintText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
    </Style>

    <!-- 빈 결과 영역 위에 가운데 표시하는 안내 문구(첫 조회 전, 또는 조회 결과가 없을 때) — 빈 표/차트가
         고장 난 화면이 아니라 "아직 조회 안 함"으로 읽히게 한다. -->
    <Style x:Key="EmptyStateText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="LineHeight" Value="20"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <!-- 레인 차트의 최대/최소 축 값. 패널 색 배경 위에 그려서, 레인의 위/아래 가장자리를 따라 지나가는
         점검/최소 점선 기준선과 겹쳐도 읽을 수 있게 한다. -->
    <Style x:Key="LaneAxisLabelBox" TargetType="Border">
        <Setter Property="Background" Value="#CC181C22"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Padding" Value="3,0"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>
    <Style x:Key="LaneAxisLabelText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="9.5"/>
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    </Style>

    <!-- Legend entry text next to the colored swatches (측정/점검/최소) — vertically centered on the swatch. -->
    <Style x:Key="LegendText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="5,0,14,0"/>
    </Style>

    <Style x:Key="MonoSmall" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
    </Style>

    <!-- ===================== 플랫 / 고스트 버튼 ===================== -->
    <Style x:Key="FlatButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PanelHoverBgBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>

    <!-- Filter-bar action button (조회/CSV 저장/인쇄/닫기) — same ghost look as FlatButton but with a light border, since these buttons sit directly on the page background rather than inside a popup. -->
    <Style x:Key="FilterActionButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PanelHoverBgBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== 폼 컨트롤 (필터 바) ===================== -->

    <!-- ComboBox의 기본 테마는 드롭다운 팝업을 일반 흰색 시스템 팝업으로 하드코딩하는데, 우리의 흰색 Foreground와
         겹쳐 드롭다운 글자를 읽을 수 없게 된다 — 그래서 여기 다른 컨트롤과 달리 ControlTemplate 전체가 필요하다
         (속성 Setter만으로는 팝업 자체의 배경에 닿지 않는다). -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PanelHoverBgBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BorderLightBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource BgBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="MinWidth" Value="110"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleBtn" Focusable="False" ClickMode="Press"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"
                                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}"
                                            BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource TemplatedParent}}"
                                            CornerRadius="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="1" Text="▾" Foreground="{StaticResource TextSecondaryBrush}"
                                                       Margin="0,0,10,0" VerticalAlignment="Center" FontSize="10"/>
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                            <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderLightBrush}"
                                    BorderThickness="1" CornerRadius="6" MaxHeight="280"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" Opacity="0.5" BlurRadius="20" ShadowDepth="4"/>
                                </Border.Effect>
                                <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <!-- 위의 ComboBox/DatePicker와 같은 종류의 버그: Foreground만 지정해서는 CheckBox 기본 템플릿의 Content
             글자에 확실히 닿지 않는다. TextElement.Foreground로 강제한다. -->
        <Setter Property="TextElement.Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Margin" Value="0,5"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="FilterLabel" TargetType="TextBlock" BasedOn="{StaticResource HintText}">
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ===================== DataGrid (조회 결과 표) ===================== -->
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource SidebarBgBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Padding" Value="8,7"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush1}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>

    <!-- 6채널(주파수 3 + 전압 3) 측정컬럼을 진짜 병합(colspan) 헤더로 보여주기 위한 커스텀 헤더 셀 스타일
         (궤도 장애·경보 리스트, 레벨 기록 리스트). WPF DataGrid는 컬럼 헤더 병합을 기본 지원하지
         않으므로, 네이티브 헤더는 숨기고(HeadersVisibility="None") 컬럼 폭과 정확히 일치하는
         ColumnDefinition을 가진 별도 Grid를 DataGrid 위에 얹어 Grid.ColumnSpan으로 실제 셀을 합친다
         — 1단 "송신"/"수신"(24컬럼 병합), 2단 채널명(4컬럼 병합), 3단 표준/측정/점검/최소(개별 컬럼).
         식별 컬럼(궤도명칭 등)은 3개 행 전체를 세로로 병합(GroupHeaderCell)한다. -->
    <Style x:Key="GroupHeaderCell" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SidebarBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush1}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="Padding" Value="4,2"/>
    </Style>
    <Style x:Key="TxGroupHeaderCell" TargetType="Border" BasedOn="{StaticResource GroupHeaderCell}">
        <Setter Property="Background" Value="#334C9AFF"/>
    </Style>
    <Style x:Key="RxGroupHeaderCell" TargetType="Border" BasedOn="{StaticResource GroupHeaderCell}">
        <Setter Property="Background" Value="#334EE1D6"/>
    </Style>

    <Style x:Key="ChannelGroupLabelText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="ChannelNameLabelText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="ChannelMetricLabelText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- 기본 DataGridCell 템플릿은 Padding/HorizontalContentAlignment를 무시해서, 모든 컬럼에서 글자가 왼쪽
         가장자리에 붙어 있었다(가운데 정렬된 헤더 아래에서 눈에 띄게 어긋남). 이 템플릿은 실제로 이를 적용한다:
         값은 컬럼 안에서 가운데, 행 안에서 세로 가운데로 정렬된다. -->
    <Style TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource PanelHoverBgBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource PanelBgBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush1}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="RowBackground" Value="{StaticResource PanelBgBrush}"/>
        <Setter Property="AlternatingRowBackground" Value="{StaticResource BgBrush}"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrush1}"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="CanUserReorderColumns" Value="False"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="RowHeight" Value="30"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
    </Style>

</ResourceDictionary>

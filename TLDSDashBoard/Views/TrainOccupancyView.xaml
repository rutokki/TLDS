<UserControl x:Class="TLDSDashBoard.Views.TrainOccupancyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:TLDSDashBoard.Views"
             mc:Ignorable="d">

    <!-- DataContext를 UserControl 루트가 아니라 여기서 재정의해서, 바깥(MainViewModel에 대한 것, 예: MainWindow.xaml)에서
         지정한 Visibility 바인딩이 계속 동작하게 한다 — 같은 패턴은 MetricGroupView 참고. 루트 자체에서
         재정의하면 그 바깥 바인딩이 조용히 깨진다. -->
    <Grid DataContext="{Binding TrainOccupancy}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 필터 바 -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,16">
            <StackPanel>
                <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="기간" Style="{StaticResource FilterLabel}"/>
                    <views:DateRangeFilterView Filter="{Binding Range}" Margin="0,0,20,6"/>

                    <TextBlock Text="역 선택" Style="{StaticResource FilterLabel}"/>
                    <ComboBox ItemsSource="{Binding Stations}" SelectedItem="{Binding SelectedStation}"
                              ItemTemplate="{StaticResource NameItemTemplate}" Margin="0,0,20,6"/>

                    <TextBlock Text="궤도 선택" Style="{StaticResource FilterLabel}"/>
                    <ComboBox ItemsSource="{Binding Tracks}" SelectedItem="{Binding SelectedTrack}"
                              ItemTemplate="{StaticResource NameItemTemplate}" Margin="0,0,0,6"/>
                </WrapPanel>

                <WrapPanel Orientation="Horizontal">
                    <Button Style="{StaticResource FilterActionButton}" Command="{Binding SearchCommand}" Margin="0,0,8,0">
                        <TextBlock Text="조회"/>
                    </Button>
                    <Button Style="{StaticResource FilterActionButton}" Command="{Binding ExportCsvCommand}" Margin="0,0,8,0">
                        <TextBlock Text="CSV 저장"/>
                    </Button>
                    <Button Style="{StaticResource FilterActionButton}" Command="{Binding PrintCommand}" Margin="0,0,16,0">
                        <TextBlock Text="인쇄"/>
                    </Button>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource HintText}" VerticalAlignment="Center"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <DataGrid ItemsSource="{Binding Results}" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="궤도명칭" Binding="{Binding TrackName}" Width="*"/>
                        <DataGridTextColumn Header="열차 진입 시간" Binding="{Binding EntryTime}" Width="*"/>
                        <DataGridTextColumn Header="열차 통과 시간" Binding="{Binding PassTime}" Width="*"/>
                        <DataGridTextColumn Header="열차 점유 시간" Binding="{Binding OccupancyTime}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Style="{StaticResource EmptyStateText}" Text="조회 결과가 없습니다.&#x0a;기간과 역/궤도를 선택한 뒤 [조회]를 눌러주세요."
                           Visibility="{Binding Results.Count, Converter={StaticResource ZeroToVisibilityConverter}}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="TLDSDashBoard.Views.TrackFaultListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:TLDSDashBoard.Views"
             mc:Ignorable="d">

    <!-- DataContext is overridden here (not on the UserControl root) so a Visibility binding set from
         outside (against MainViewModel) keeps working — see MetricGroupView for the same pattern. -->
    <Grid DataContext="{Binding TrackFaultList}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Filter bar -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,16">
            <StackPanel>
                <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="기간" Style="{StaticResource FilterLabel}"/>
                    <views:DateRangeFilterView Filter="{Binding Range}" Margin="0,0,20,6"/>

                    <TextBlock Text="역" Style="{StaticResource FilterLabel}"/>
                    <ComboBox ItemsSource="{Binding Stations}" SelectedItem="{Binding SelectedStation}"
                              ItemTemplate="{StaticResource NameItemTemplate}" Margin="0,0,12,6"/>

                    <ComboBox ItemsSource="{Binding Tracks}" SelectedItem="{Binding SelectedTrack}"
                              ItemTemplate="{StaticResource NameItemTemplate}" Margin="0,0,12,6"/>

                    <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}" Margin="0,0,0,6"/>
                </WrapPanel>

                <WrapPanel Orientation="Horizontal">
                    <Button Style="{StaticResource FilterActionButton}" Command="{Binding SearchCommand}" Margin="0,0,8,0">
                        <TextBlock Text="조회"/>
                    </Button>
                    <Button Style="{StaticResource FilterActionButton}" Command="{Binding ExportCsvCommand}" Margin="0,0,8,0">
                        <TextBlock Text="CSV 저장"/>
                    </Button>
                    <Button Style="{StaticResource FilterActionButton}" Command="{Binding PrintCommand}" Margin="0,0,16,0">
                        <TextBlock Text="인쇄"/>
                    </Button>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource HintText}" VerticalAlignment="Center"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Wide measurement table (12 channels × 표준/측정/점검/최소 = 48 columns, plus 8 identifying columns) — horizontal scroll expected. -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding Results}" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="궤도명칭" Binding="{Binding TrackName}" Width="90"/>
                    <DataGridTextColumn Header="일자" Binding="{Binding Date}" Width="90"/>
                    <DataGridTextColumn Header="발생시각" Binding="{Binding OccurredAt}" Width="80"/>
                    <DataGridTextColumn Header="복구시각" Binding="{Binding RecoveredAt}" Width="80"/>
                    <DataGridTextColumn Header="장애종류" Binding="{Binding FaultType}" Width="90"/>
                    <DataGridTextColumn Header="IMP" Binding="{Binding Imp}" Width="60"/>
                    <DataGridTextColumn Header="AF" Binding="{Binding Af}" Width="60"/>
                    <DataGridTextColumn Header="궤도타입" Binding="{Binding TrackType}" Width="70"/>

                    <DataGridTextColumn Header="TAC-표준" Binding="{Binding Tac.Standard, StringFormat=F1}" Width="70"/>
                    <DataGridTextColumn Header="TAC-측정" Binding="{Binding Tac.Measured, StringFormat=F1}" Width="70"/>
                    <DataGridTextColumn Header="TAC-점검" Binding="{Binding Tac.Checked, StringFormat=F1}" Width="70"/>
                    <DataGridTextColumn Header="TAC-최소" Binding="{Binding Tac.Minimum, StringFormat=F1}" Width="70"/>

                    <DataGridTextColumn Header="TV-표준" Binding="{Binding Tv.Standard, StringFormat=F1}" Width="70"/>
                    <DataGridTextColumn Header="TV-측정" Binding="{Binding Tv.Measured, StringFormat=F1}" Width="70"/>
                    <DataGridTextColumn Header="TV-점검" Binding="{Binding Tv.Checked, StringFormat=F1}" Width="70"/>
                    <DataGridTextColumn Header="TV-최소" Binding="{Binding Tv.Minimum, StringFormat=F1}" Width="70"/>

                    <DataGridTextColumn Header="TFP-표준" Binding="{Binding Tfp.Standard, StringFormat=F1}" Width="70"/>
                    <DataGridTextColumn Header="TFP-측정" Binding="{Binding Tfp.Measured, StringFormat=F1}" Width="70"/>
                    <DataGridTextColumn Header="TFP-점검" Binding="{Binding Tfp.Checked, StringFormat=F1}" Width="70"/>
                    <DataGridTextColumn Header="TFP-최소" Binding="{Binding Tfp.Minimum, StringFormat=F1}" Width="70"/>

                    <DataGridTextColumn Header="TSP-표준" Binding="{Binding Tsp.Standard, StringFormat=F1}" Width="70"/>
                    <DataGridTextColumn Header="TSP-측정" Binding="{Binding Tsp.Measured, StringFormat=F1}" Width="70"/>
                    <DataGridTextColumn Header="TSP-점검" Binding="{Binding Tsp.Checked, StringFormat=F1}" Width="70"/>
                    <DataGridTextColumn Header="TSP-최소" Binding="{Binding Tsp.Minimum, StringFormat=F1}" Width="70"/>

                    <DataGridTextColumn Header="THZ-표준" Binding="{Binding Thz.Standard, StringFormat=F2}" Width="70"/>
                    <DataGridTextColumn Header="THZ-측정" Binding="{Binding Thz.Measured, StringFormat=F2}" Width="70"/>
                    <DataGridTextColumn Header="THZ-점검" Binding="{Binding Thz.Checked, StringFormat=F2}" Width="70"/>
                    <DataGridTextColumn Header="THZ-최소" Binding="{Binding Thz.Minimum, StringFormat=F2}" Width="70"/>

                    <DataGridTextColumn Header="TA-표준" Binding="{Binding Ta.Standard, StringFormat=F2}" Width="70"/>
                    <DataGridTextColumn Header="TA-측정" Binding="{Binding Ta.Measured, StringFormat=F2}" Width="70"/>
                    <DataGridTextColumn Header="TA-점검" Binding="{Binding Ta.Checked, StringFormat=F2}" Width="70"/>
                    <DataGridTextColumn Header="TA-최소" Binding="{Binding Ta.Minimum, StringFormat=F2}" Width="70"/>

                    <DataGridTextColumn Header="RFP-표준" Binding="{Binding Rfp.Standard, StringFormat=F1}" Width="70"/>
                    <DataGridTextColumn Header="RFP-측정" Binding="{Binding Rfp.Measured, StringFormat=F1}" Width="70"/>
                    <DataGridTextColumn Header="RFP-점검" Binding="{Binding Rfp.Checked, StringFormat=F1}" Width="70"/>
                    <DataGridTextColumn Header="RFP-최소" Binding="{Binding Rfp.Minimum, StringFormat=F1}" Width="70"/>

                    <DataGridTextColumn Header="RSP-표준" Binding="{Binding Rsp.Standard, StringFormat=F1}" Width="70"/>
                    <DataGridTextColumn Header="RSP-측정" Binding="{Binding Rsp.Measured, StringFormat=F1}" Width="70"/>
                    <DataGridTextColumn Header="RSP-점검" Binding="{Binding Rsp.Checked, StringFormat=F1}" Width="70"/>
                    <DataGridTextColumn Header="RSP-최소" Binding="{Binding Rsp.Minimum, StringFormat=F1}" Width="70"/>

                    <DataGridTextColumn Header="RHZ-표준" Binding="{Binding Rhz.Standard, StringFormat=F2}" Width="70"/>
                    <DataGridTextColumn Header="RHZ-측정" Binding="{Binding Rhz.Measured, StringFormat=F2}" Width="70"/>
                    <DataGridTextColumn Header="RHZ-점검" Binding="{Binding Rhz.Checked, StringFormat=F2}" Width="70"/>
                    <DataGridTextColumn Header="RHZ-최소" Binding="{Binding Rhz.Minimum, StringFormat=F2}" Width="70"/>

                    <DataGridTextColumn Header="RA-표준" Binding="{Binding Ra.Standard, StringFormat=F2}" Width="70"/>
                    <DataGridTextColumn Header="RA-측정" Binding="{Binding Ra.Measured, StringFormat=F2}" Width="70"/>
                    <DataGridTextColumn Header="RA-점검" Binding="{Binding Ra.Checked, StringFormat=F2}" Width="70"/>
                    <DataGridTextColumn Header="RA-최소" Binding="{Binding Ra.Minimum, StringFormat=F2}" Width="70"/>

                    <DataGridTextColumn Header="RV1-표준" Binding="{Binding Rv1.Standard, StringFormat=F1}" Width="70"/>
                    <DataGridTextColumn Header="RV1-측정" Binding="{Binding Rv1.Measured, StringFormat=F1}" Width="70"/>
                    <DataGridTextColumn Header="RV1-점검" Binding="{Binding Rv1.Checked, StringFormat=F1}" Width="70"/>
                    <DataGridTextColumn Header="RV1-최소" Binding="{Binding Rv1.Minimum, StringFormat=F1}" Width="70"/>

                    <DataGridTextColumn Header="RV2-표준" Binding="{Binding Rv2.Standard, StringFormat=F1}" Width="70"/>
                    <DataGridTextColumn Header="RV2-측정" Binding="{Binding Rv2.Measured, StringFormat=F1}" Width="70"/>
                    <DataGridTextColumn Header="RV2-점검" Binding="{Binding Rv2.Checked, StringFormat=F1}" Width="70"/>
                    <DataGridTextColumn Header="RV2-최소" Binding="{Binding Rv2.Minimum, StringFormat=F1}" Width="70"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>

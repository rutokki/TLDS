<UserControl x:Class="TLDSDashBoard.Views.TrackFaultListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:TLDSDashBoard.Views"
             mc:Ignorable="d">

    <!-- DataContext를 UserControl 루트가 아니라 여기서 재정의해서, 바깥(MainViewModel에 대한)에서 지정한
         Visibility 바인딩이 계속 동작하게 한다 — 같은 패턴은 MetricGroupView 참고. -->
    <Grid DataContext="{Binding TrackFaultList}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 필터 바 -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,16">
            <StackPanel>
                <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="기간" Style="{StaticResource FilterLabel}"/>
                    <views:DateRangeFilterView Filter="{Binding Range}" Margin="0,0,20,6"/>

                    <TextBlock Text="역" Style="{StaticResource FilterLabel}"/>
                    <ComboBox ItemsSource="{Binding Stations}" SelectedItem="{Binding SelectedStation}"
                              ItemTemplate="{StaticResource NameItemTemplate}" Margin="0,0,12,6"/>

                    <ComboBox ItemsSource="{Binding Tracks}" SelectedItem="{Binding SelectedTrack}"
                              ItemTemplate="{StaticResource NameItemTemplate}" Margin="0,0,12,6"/>

                    <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}" Margin="0,0,0,6"/>
                </WrapPanel>

                <WrapPanel Orientation="Horizontal">
                    <Button Style="{StaticResource FilterActionButton}" Command="{Binding SearchCommand}" Margin="0,0,8,0">
                        <TextBlock Text="조회"/>
                    </Button>
                    <Button Style="{StaticResource FilterActionButton}" Command="{Binding ExportCsvCommand}" Margin="0,0,8,0">
                        <TextBlock Text="CSV 저장"/>
                    </Button>
                    <Button Style="{StaticResource FilterActionButton}" Command="{Binding PrintCommand}" Margin="0,0,16,0">
                        <TextBlock Text="인쇄"/>
                    </Button>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource HintText}" VerticalAlignment="Center"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- 넓은 측정 표(6채널 × 표준/측정/점검/최소 = 24컬럼, 거기에 식별 컬럼 8개). DataGrid 자체 헤더는 숨기고
             (HeadersVisibility="None"), 각 DataGridTextColumn의 Width와 픽셀 단위로 일치하는 ColumnDefinitions를 가진
             별도의 Grid를 그 위에 두어 실제 Grid.ColumnSpan으로 셀을 병합한다 — 1단 주파수/전압(12컬럼씩), 2단
             채널명(4컬럼), 3단 표준/측정/점검/최소(개별). 헤더는 자신만의 가로 전용 ScrollViewer 안에 있고,
             DataGrid는 자신의 세로+가로 스크롤을 유지한다(코드비하인드의 MainGrid_ScrollChanged로 헤더와 동기화) —
             DataGrid를 세로 스크롤이 있는 바깥 ScrollViewer 안에 넣으면 뷰포트가 무한해져서 UI 가상화가 완전히
             꺼지고, 넓은 기간 조회(많은 알람 행)가 메모리/성능 문제가 된다(행 수가 늘자 실제로 그 문제를 겪은
             LevelRecordListView 참고). 컬럼 크기 조절은 헤더와 그리드가 어긋나게 되므로
             (CanUserResizeColumns) 꺼 두었다. -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" x:Name="HeaderScroll" HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled" IsHitTestVisible="False">
                    <Grid>
<Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
</Grid.RowDefinitions>
<Grid.ColumnDefinitions>
    <ColumnDefinition Width="90"/>
    <ColumnDefinition Width="90"/>
    <ColumnDefinition Width="80"/>
    <ColumnDefinition Width="80"/>
    <ColumnDefinition Width="90"/>
    <ColumnDefinition Width="60"/>
    <ColumnDefinition Width="60"/>
    <ColumnDefinition Width="70"/>
    <ColumnDefinition Width="70"/>
    <ColumnDefinition Width="70"/>
    <ColumnDefinition Width="70"/>
    <ColumnDefinition Width="70"/>
    <ColumnDefinition Width="70"/>
    <ColumnDefinition Width="70"/>
    <ColumnDefinition Width="70"/>
    <ColumnDefinition Width="70"/>
    <ColumnDefinition Width="70"/>
    <ColumnDefinition Width="70"/>
    <ColumnDefinition Width="70"/>
    <ColumnDefinition Width="70"/>
    <ColumnDefinition Width="70"/>
    <ColumnDefinition Width="70"/>
    <ColumnDefinition Width="70"/>
    <ColumnDefinition Width="70"/>
    <ColumnDefinition Width="70"/>
    <ColumnDefinition Width="70"/>
    <ColumnDefinition Width="70"/>
    <ColumnDefinition Width="70"/>
    <ColumnDefinition Width="70"/>
    <ColumnDefinition Width="70"/>
    <ColumnDefinition Width="70"/>
    <ColumnDefinition Width="70"/>
    <!-- 스페이서 = DataGrid 세로 스크롤바 폭(Styles.xaml ScrollBar Width=10): 없으면 헤더의 스크롤 가능한 폭이
         그리드보다 10px 짧아서, 맨 오른쪽에서 헤더가 일찍 멈추고 아래 컬럼과 어긋나게 된다. -->
    <ColumnDefinition Width="10"/>
</Grid.ColumnDefinitions>


<!-- 식별 컬럼: 3개 행 전체를 세로로 병합 -->
<Border Grid.Column="0" Grid.RowSpan="3" Style="{StaticResource GroupHeaderCell}"><TextBlock Text="궤도명칭" Style="{StaticResource ChannelMetricLabelText}"/></Border>
<Border Grid.Column="1" Grid.RowSpan="3" Style="{StaticResource GroupHeaderCell}"><TextBlock Text="일자" Style="{StaticResource ChannelMetricLabelText}"/></Border>
<Border Grid.Column="2" Grid.RowSpan="3" Style="{StaticResource GroupHeaderCell}"><TextBlock Text="발생시각" Style="{StaticResource ChannelMetricLabelText}"/></Border>
<Border Grid.Column="3" Grid.RowSpan="3" Style="{StaticResource GroupHeaderCell}"><TextBlock Text="복구시각" Style="{StaticResource ChannelMetricLabelText}"/></Border>
<Border Grid.Column="4" Grid.RowSpan="3" Style="{StaticResource GroupHeaderCell}"><TextBlock Text="장애종류" Style="{StaticResource ChannelMetricLabelText}"/></Border>
<Border Grid.Column="5" Grid.RowSpan="3" Style="{StaticResource GroupHeaderCell}"><TextBlock Text="IMP" Style="{StaticResource ChannelMetricLabelText}"/></Border>
<Border Grid.Column="6" Grid.RowSpan="3" Style="{StaticResource GroupHeaderCell}"><TextBlock Text="AF" Style="{StaticResource ChannelMetricLabelText}"/></Border>
<Border Grid.Column="7" Grid.RowSpan="3" Style="{StaticResource GroupHeaderCell}"><TextBlock Text="궤도타입" Style="{StaticResource ChannelMetricLabelText}"/></Border>

<!-- 1단: 주파수/전압 그룹 병합 -->
<Border Grid.Row="0" Grid.Column="8" Grid.ColumnSpan="12" Style="{StaticResource TxGroupHeaderCell}"><TextBlock Text="주파수" Style="{StaticResource ChannelGroupLabelText}"/></Border>
<Border Grid.Row="0" Grid.Column="20" Grid.ColumnSpan="12" Style="{StaticResource RxGroupHeaderCell}"><TextBlock Text="전압" Style="{StaticResource ChannelGroupLabelText}"/></Border>

<!-- 2단: 채널명 병합 (4컬럼씩) -->
<Border Grid.Row="1" Grid.Column="8" Grid.ColumnSpan="4" Style="{StaticResource TxGroupHeaderCell}"><TextBlock Text="궤도 주파수" Style="{StaticResource ChannelNameLabelText}"/></Border>
<Border Grid.Row="1" Grid.Column="12" Grid.ColumnSpan="4" Style="{StaticResource TxGroupHeaderCell}"><TextBlock Text="차상 주파수" Style="{StaticResource ChannelNameLabelText}"/></Border>
<Border Grid.Row="1" Grid.Column="16" Grid.ColumnSpan="4" Style="{StaticResource TxGroupHeaderCell}"><TextBlock Text="지상 주파수" Style="{StaticResource ChannelNameLabelText}"/></Border>
<Border Grid.Row="1" Grid.Column="20" Grid.ColumnSpan="4" Style="{StaticResource RxGroupHeaderCell}"><TextBlock Text="송신 전압" Style="{StaticResource ChannelNameLabelText}"/></Border>
<Border Grid.Row="1" Grid.Column="24" Grid.ColumnSpan="4" Style="{StaticResource RxGroupHeaderCell}"><TextBlock Text="수신 A 전압" Style="{StaticResource ChannelNameLabelText}"/></Border>
<Border Grid.Row="1" Grid.Column="28" Grid.ColumnSpan="4" Style="{StaticResource RxGroupHeaderCell}"><TextBlock Text="수신 B 전압" Style="{StaticResource ChannelNameLabelText}"/></Border>

<!-- 3단: 표준/측정/점검/최소 개별 컬럼 -->
<Border Grid.Row="2" Grid.Column="8" Style="{StaticResource TxGroupHeaderCell}"><TextBlock Text="표준" Style="{StaticResource ChannelMetricLabelText}"/></Border>
<Border Grid.Row="2" Grid.Column="9" Style="{StaticResource TxGroupHeaderCell}"><TextBlock Text="측정" Style="{StaticResource ChannelMetricLabelText}"/></Border>
<Border Grid.Row="2" Grid.Column="10" Style="{StaticResource TxGroupHeaderCell}"><TextBlock Text="점검" Style="{StaticResource ChannelMetricLabelText}"/></Border>
<Border Grid.Row="2" Grid.Column="11" Style="{StaticResource TxGroupHeaderCell}"><TextBlock Text="최소" Style="{StaticResource ChannelMetricLabelText}"/></Border>
<Border Grid.Row="2" Grid.Column="12" Style="{StaticResource TxGroupHeaderCell}"><TextBlock Text="표준" Style="{StaticResource ChannelMetricLabelText}"/></Border>
<Border Grid.Row="2" Grid.Column="13" Style="{StaticResource TxGroupHeaderCell}"><TextBlock Text="측정" Style="{StaticResource ChannelMetricLabelText}"/></Border>
<Border Grid.Row="2" Grid.Column="14" Style="{StaticResource TxGroupHeaderCell}"><TextBlock Text="점검" Style="{StaticResource ChannelMetricLabelText}"/></Border>
<Border Grid.Row="2" Grid.Column="15" Style="{StaticResource TxGroupHeaderCell}"><TextBlock Text="최소" Style="{StaticResource ChannelMetricLabelText}"/></Border>
<Border Grid.Row="2" Grid.Column="16" Style="{StaticResource TxGroupHeaderCell}"><TextBlock Text="표준" Style="{StaticResource ChannelMetricLabelText}"/></Border>
<Border Grid.Row="2" Grid.Column="17" Style="{StaticResource TxGroupHeaderCell}"><TextBlock Text="측정" Style="{StaticResource ChannelMetricLabelText}"/></Border>
<Border Grid.Row="2" Grid.Column="18" Style="{StaticResource TxGroupHeaderCell}"><TextBlock Text="점검" Style="{StaticResource ChannelMetricLabelText}"/></Border>
<Border Grid.Row="2" Grid.Column="19" Style="{StaticResource TxGroupHeaderCell}"><TextBlock Text="최소" Style="{StaticResource ChannelMetricLabelText}"/></Border>
<Border Grid.Row="2" Grid.Column="20" Style="{StaticResource RxGroupHeaderCell}"><TextBlock Text="표준" Style="{StaticResource ChannelMetricLabelText}"/></Border>
<Border Grid.Row="2" Grid.Column="21" Style="{StaticResource RxGroupHeaderCell}"><TextBlock Text="측정" Style="{StaticResource ChannelMetricLabelText}"/></Border>
<Border Grid.Row="2" Grid.Column="22" Style="{StaticResource RxGroupHeaderCell}"><TextBlock Text="점검" Style="{StaticResource ChannelMetricLabelText}"/></Border>
<Border Grid.Row="2" Grid.Column="23" Style="{StaticResource RxGroupHeaderCell}"><TextBlock Text="최소" Style="{StaticResource ChannelMetricLabelText}"/></Border>
<Border Grid.Row="2" Grid.Column="24" Style="{StaticResource RxGroupHeaderCell}"><TextBlock Text="표준" Style="{StaticResource ChannelMetricLabelText}"/></Border>
<Border Grid.Row="2" Grid.Column="25" Style="{StaticResource RxGroupHeaderCell}"><TextBlock Text="측정" Style="{StaticResource ChannelMetricLabelText}"/></Border>
<Border Grid.Row="2" Grid.Column="26" Style="{StaticResource RxGroupHeaderCell}"><TextBlock Text="점검" Style="{StaticResource ChannelMetricLabelText}"/></Border>
<Border Grid.Row="2" Grid.Column="27" Style="{StaticResource RxGroupHeaderCell}"><TextBlock Text="최소" Style="{StaticResource ChannelMetricLabelText}"/></Border>
<Border Grid.Row="2" Grid.Column="28" Style="{StaticResource RxGroupHeaderCell}"><TextBlock Text="표준" Style="{StaticResource ChannelMetricLabelText}"/></Border>
<Border Grid.Row="2" Grid.Column="29" Style="{StaticResource RxGroupHeaderCell}"><TextBlock Text="측정" Style="{StaticResource ChannelMetricLabelText}"/></Border>
<Border Grid.Row="2" Grid.Column="30" Style="{StaticResource RxGroupHeaderCell}"><TextBlock Text="점검" Style="{StaticResource ChannelMetricLabelText}"/></Border>
<Border Grid.Row="2" Grid.Column="31" Style="{StaticResource RxGroupHeaderCell}"><TextBlock Text="최소" Style="{StaticResource ChannelMetricLabelText}"/></Border>
                    </Grid>
                </ScrollViewer>

                <DataGrid Grid.Row="1" x:Name="MainGrid" ItemsSource="{Binding Results}" BorderThickness="0" HeadersVisibility="None"
                              CanUserResizeColumns="False"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.ScrollChanged="MainGrid_ScrollChanged"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True">
                        <DataGrid.Columns>
<DataGridTextColumn Binding="{Binding TrackName}" Width="90"/>
<DataGridTextColumn Binding="{Binding Date}" Width="90"/>
<DataGridTextColumn Binding="{Binding OccurredAt}" Width="80"/>
<DataGridTextColumn Binding="{Binding RecoveredAt}" Width="80"/>
<DataGridTextColumn Binding="{Binding FaultType}" Width="90"/>
<DataGridTextColumn Binding="{Binding Imp}" Width="60"/>
<DataGridTextColumn Binding="{Binding Af}" Width="60"/>
<DataGridTextColumn Binding="{Binding TrackType}" Width="70"/>
<DataGridTextColumn Binding="{Binding TRK_FREQ.Standard, StringFormat=F0}" Width="70"/>
<DataGridTextColumn Binding="{Binding TRK_FREQ.Measured, StringFormat=F0}" Width="70"/>
<DataGridTextColumn Binding="{Binding TRK_FREQ.Checked, StringFormat=F0}" Width="70"/>
<DataGridTextColumn Binding="{Binding TRK_FREQ.Minimum, StringFormat=F0}" Width="70"/>
<DataGridTextColumn Binding="{Binding CAB_FREQ.Standard, StringFormat=F0}" Width="70"/>
<DataGridTextColumn Binding="{Binding CAB_FREQ.Measured, StringFormat=F0}" Width="70"/>
<DataGridTextColumn Binding="{Binding CAB_FREQ.Checked, StringFormat=F0}" Width="70"/>
<DataGridTextColumn Binding="{Binding CAB_FREQ.Minimum, StringFormat=F0}" Width="70"/>
<DataGridTextColumn Binding="{Binding CODE_FREQ.Standard, StringFormat=F2}" Width="70"/>
<DataGridTextColumn Binding="{Binding CODE_FREQ.Measured, StringFormat=F2}" Width="70"/>
<DataGridTextColumn Binding="{Binding CODE_FREQ.Checked, StringFormat=F2}" Width="70"/>
<DataGridTextColumn Binding="{Binding CODE_FREQ.Minimum, StringFormat=F2}" Width="70"/>
<DataGridTextColumn Binding="{Binding TX_VOLTAGE.Standard, StringFormat=F1}" Width="70"/>
<DataGridTextColumn Binding="{Binding TX_VOLTAGE.Measured, StringFormat=F1}" Width="70"/>
<DataGridTextColumn Binding="{Binding TX_VOLTAGE.Checked, StringFormat=F1}" Width="70"/>
<DataGridTextColumn Binding="{Binding TX_VOLTAGE.Minimum, StringFormat=F1}" Width="70"/>
<DataGridTextColumn Binding="{Binding RX_A_VOLTAGE.Standard, StringFormat=F2}" Width="70"/>
<DataGridTextColumn Binding="{Binding RX_A_VOLTAGE.Measured, StringFormat=F2}" Width="70"/>
<DataGridTextColumn Binding="{Binding RX_A_VOLTAGE.Checked, StringFormat=F2}" Width="70"/>
<DataGridTextColumn Binding="{Binding RX_A_VOLTAGE.Minimum, StringFormat=F2}" Width="70"/>
<DataGridTextColumn Binding="{Binding RX_B_VOLTAGE.Standard, StringFormat=F2}" Width="70"/>
<DataGridTextColumn Binding="{Binding RX_B_VOLTAGE.Measured, StringFormat=F2}" Width="70"/>
<DataGridTextColumn Binding="{Binding RX_B_VOLTAGE.Checked, StringFormat=F2}" Width="70"/>
<DataGridTextColumn Binding="{Binding RX_B_VOLTAGE.Minimum, StringFormat=F2}" Width="70"/>
                        </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="1" Style="{StaticResource EmptyStateText}" Text="조회 결과가 없습니다.&#x0a;기간과 조건을 선택한 뒤 [조회]를 눌러주세요."
                           Visibility="{Binding Results.Count, Converter={StaticResource ZeroToVisibilityConverter}}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>

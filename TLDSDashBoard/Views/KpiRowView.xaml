<UserControl x:Class="TLDSDashBoard.Views.KpiRowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:items="clr-namespace:TLDSDashBoard.ViewModels.Items"
             mc:Ignorable="d" d:DesignHeight="130">

    <ItemsControl ItemsSource="{Binding Kpis}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <UniformGrid Rows="1" Columns="4"/>
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type items:KpiItemVM}">
                <Border Style="{StaticResource Card}" Padding="18,16" Margin="7,0,7,0">
                    <StackPanel>
                        <TextBlock Text="{Binding Label}" Style="{StaticResource LabelUppercase}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,10">
                            <TextBlock Text="{Binding Value}" Style="{StaticResource MonoValueBig}" VerticalAlignment="Bottom"/>
                            <TextBlock Text="{Binding Unit}" FontSize="12" Foreground="{StaticResource TextDimBrush}"
                                       Margin="6,0,0,2" VerticalAlignment="Bottom"/>
                            <TextBlock Text="{Binding DeltaLabel}" FontSize="11" Margin="10,0,0,2" VerticalAlignment="Bottom"
                                       Foreground="{Binding DeltaColorHex, Converter={StaticResource HexToBrushConverter}}"
                                       FontWeight="{Binding DeltaBold, Converter={StaticResource BoldWhenTrueConverter}}"/>
                        </StackPanel>
                        <Viewbox Stretch="Fill" Height="34">
                            <Canvas Width="200" Height="40">
                                <Path Data="{Binding SparkPath, Converter={StaticResource PathDataConverter}}"
                                      Stroke="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                      StrokeThickness="2"/>
                            </Canvas>
                        </Viewbox>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>

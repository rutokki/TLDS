<UserControl x:Class="TLDSDashBoard.Views.AlarmLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:TLDSDashBoard.Models"
             mc:Ignorable="d" d:DesignHeight="260">

    <Border Style="{StaticResource Card}">
        <StackPanel>
            <TextBlock Text="이벤트 로그 (Alarm Log)" Style="{StaticResource SectionTitle}"
                       Padding="18,14" />
            <Rectangle Height="1" Fill="{StaticResource BorderBrush1}"/>

            <!-- Header -->
            <Grid Margin="18,8,18,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Time" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Grid.Column="1" Text="Channel" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Grid.Column="2" Text="Message" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Grid.Column="3" Text="Severity" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"/>
            </Grid>

            <ItemsControl ItemsSource="{Binding Events}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:AlarmEventModel}">
                        <Border BorderBrush="{StaticResource BorderBrush1}" BorderThickness="0,1,0,0">
                            <Grid Margin="18,9,18,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Time}" FontFamily="{StaticResource MonoFont}"
                                           FontSize="12.5" Foreground="#FFA6ACB6"/>
                                <TextBlock Grid.Column="1" Text="{Binding Channel}" FontSize="12.5"/>
                                <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="12.5"
                                           Foreground="#FFD9DBDD" TextTrimming="CharacterEllipsis"/>
                                <Border Grid.Column="3" HorizontalAlignment="Left" CornerRadius="6" Padding="9,3"
                                        Background="{Binding Severity, Converter={StaticResource SeverityToBrushConverter}, ConverterParameter=Bg}">
                                    <TextBlock Text="{Binding SeverityLabel}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{Binding Severity, Converter={StaticResource SeverityToBrushConverter}, ConverterParameter=Fg}"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>

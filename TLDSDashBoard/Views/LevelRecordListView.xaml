<UserControl x:Class="TLDSDashBoard.Views.LevelRecordListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:TLDSDashBoard.Views"
             mc:Ignorable="d">

    <!-- DataContext is overridden here (not on the UserControl root) so a Visibility binding set from
         outside (against MainViewModel) keeps working — see MetricGroupView for the same pattern. -->
    <Grid DataContext="{Binding LevelRecordList}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Filter bar -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,16">
            <StackPanel>
                <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="역 선택" Style="{StaticResource FilterLabel}"/>
                    <ComboBox ItemsSource="{Binding Stations}" SelectedItem="{Binding SelectedStation}"
                              ItemTemplate="{StaticResource NameItemTemplate}" Margin="0,0,20,6"/>

                    <TextBlock Text="궤도 선택" Style="{StaticResource FilterLabel}"/>
                    <ComboBox ItemsSource="{Binding Tracks}" SelectedItem="{Binding SelectedTrack}"
                              ItemTemplate="{StaticResource NameItemTemplate}" Margin="0,0,20,6"/>

                    <TextBlock Text="기간 (최대 2시간)" Style="{StaticResource FilterLabel}"/>
                    <views:DateRangeFilterView Filter="{Binding Range}" Margin="0,0,0,6"/>
                </WrapPanel>

                <WrapPanel Orientation="Horizontal">
                    <Button Style="{StaticResource FilterActionButton}" Command="{Binding SearchCommand}" Margin="0,0,8,0">
                        <TextBlock Text="조회"/>
                    </Button>
                    <Button Style="{StaticResource FilterActionButton}" Command="{Binding ExportCsvCommand}" Margin="0,0,16,0">
                        <TextBlock Text="CSV 저장"/>
                    </Button>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource HintText}" VerticalAlignment="Center"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- 6채널(주파수 3 + 전압 3) × 표준/측정/점검/최소 = 24개 측정컬럼. DataGrid의 네이티브 헤더는 숨기고
             (HeadersVisibility="None"), 컬럼 폭과 정확히 일치하는 별도 Grid를 위에 얹어 Grid.ColumnSpan으로
             실제 셀을 병합한다 — 1단 주파수/전압(12컬럼씩), 2단 채널명(4컬럼), 3단 표준/측정/점검/최소(개별).
             헤더 Grid는 가로 스크롤 전용 ScrollViewer(가로만, 세로 없음) 안에 있고, DataGrid는 자기 자신의
             가로/세로 스크롤을 그대로 가진다 — DataGrid를 세로 스크롤이 없는 바깥 ScrollViewer에 넣으면 뷰포트가
             무한 높이가 되어 UI 가상화(virtualization)가 완전히 꺼져버린다(모든 행이 실제 UI 엘리먼트로 즉시
             생성됨). 초 단위 실데이터로 행 수가 수천~수만 개까지 늘어나면서 이 문제가 메모리 폭증으로 드러났음.
             DataGrid가 스크롤될 때 코드비하인드(MainGrid_ScrollChanged)에서 헤더의 가로 오프셋만 맞춰준다. -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" x:Name="HeaderScroll" HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled" IsHitTestVisible="False">
                    <Grid>
<Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
</Grid.RowDefinitions>
<Grid.ColumnDefinitions>
    <ColumnDefinition Width="120"/>
    <ColumnDefinition Width="90"/>
    <ColumnDefinition Width="80"/>
    <ColumnDefinition Width="80"/>
    <ColumnDefinition Width="80"/>
    <ColumnDefinition Width="80"/>
    <ColumnDefinition Width="80"/>
    <ColumnDefinition Width="80"/>
    <ColumnDefinition Width="80"/>
    <ColumnDefinition Width="80"/>
    <ColumnDefinition Width="80"/>
    <ColumnDefinition Width="80"/>
    <ColumnDefinition Width="80"/>
    <ColumnDefinition Width="80"/>
    <ColumnDefinition Width="80"/>
    <ColumnDefinition Width="80"/>
    <ColumnDefinition Width="80"/>
    <ColumnDefinition Width="80"/>
    <ColumnDefinition Width="80"/>
    <ColumnDefinition Width="80"/>
    <ColumnDefinition Width="80"/>
    <ColumnDefinition Width="80"/>
    <ColumnDefinition Width="80"/>
    <ColumnDefinition Width="80"/>
    <ColumnDefinition Width="80"/>
    <ColumnDefinition Width="80"/>
    <!-- Spacer = DataGrid vertical scrollbar width (Styles.xaml ScrollBar Width=10): without it the header's
         scrollable width is 10px shorter than the grid's, so at the far right the header stops early and
         drifts out of line with the columns below. -->
    <ColumnDefinition Width="10"/>
</Grid.ColumnDefinitions>


<!-- 식별 컬럼: 3개 행 전체를 세로로 병합 -->
<Border Grid.Column="0" Grid.RowSpan="3" Style="{StaticResource GroupHeaderCell}"><TextBlock Text="궤도명칭" Style="{StaticResource ChannelMetricLabelText}"/></Border>
<Border Grid.Column="1" Grid.RowSpan="3" Style="{StaticResource GroupHeaderCell}"><TextBlock Text="시간" Style="{StaticResource ChannelMetricLabelText}"/></Border>

<!-- 1단: 주파수/전압 그룹 병합 -->
<Border Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="12" Style="{StaticResource TxGroupHeaderCell}"><TextBlock Text="주파수" Style="{StaticResource ChannelGroupLabelText}"/></Border>
<Border Grid.Row="0" Grid.Column="14" Grid.ColumnSpan="12" Style="{StaticResource RxGroupHeaderCell}"><TextBlock Text="전압" Style="{StaticResource ChannelGroupLabelText}"/></Border>

<!-- 2단: 채널명 병합 (4컬럼씩) -->
<Border Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="4" Style="{StaticResource TxGroupHeaderCell}"><TextBlock Text="궤도 주파수" Style="{StaticResource ChannelNameLabelText}"/></Border>
<Border Grid.Row="1" Grid.Column="6" Grid.ColumnSpan="4" Style="{StaticResource TxGroupHeaderCell}"><TextBlock Text="차상 주파수" Style="{StaticResource ChannelNameLabelText}"/></Border>
<Border Grid.Row="1" Grid.Column="10" Grid.ColumnSpan="4" Style="{StaticResource TxGroupHeaderCell}"><TextBlock Text="지상 주파수" Style="{StaticResource ChannelNameLabelText}"/></Border>
<Border Grid.Row="1" Grid.Column="14" Grid.ColumnSpan="4" Style="{StaticResource RxGroupHeaderCell}"><TextBlock Text="송신 전압" Style="{StaticResource ChannelNameLabelText}"/></Border>
<Border Grid.Row="1" Grid.Column="18" Grid.ColumnSpan="4" Style="{StaticResource RxGroupHeaderCell}"><TextBlock Text="수신 A 전압" Style="{StaticResource ChannelNameLabelText}"/></Border>
<Border Grid.Row="1" Grid.Column="22" Grid.ColumnSpan="4" Style="{StaticResource RxGroupHeaderCell}"><TextBlock Text="수신 B 전압" Style="{StaticResource ChannelNameLabelText}"/></Border>

<!-- 3단: 표준/측정/점검/최소 개별 컬럼 -->
<Border Grid.Row="2" Grid.Column="2" Style="{StaticResource TxGroupHeaderCell}"><TextBlock Text="표준" Style="{StaticResource ChannelMetricLabelText}"/></Border>
<Border Grid.Row="2" Grid.Column="3" Style="{StaticResource TxGroupHeaderCell}"><TextBlock Text="측정" Style="{StaticResource ChannelMetricLabelText}"/></Border>
<Border Grid.Row="2" Grid.Column="4" Style="{StaticResource TxGroupHeaderCell}"><TextBlock Text="점검" Style="{StaticResource ChannelMetricLabelText}"/></Border>
<Border Grid.Row="2" Grid.Column="5" Style="{StaticResource TxGroupHeaderCell}"><TextBlock Text="최소" Style="{StaticResource ChannelMetricLabelText}"/></Border>
<Border Grid.Row="2" Grid.Column="6" Style="{StaticResource TxGroupHeaderCell}"><TextBlock Text="표준" Style="{StaticResource ChannelMetricLabelText}"/></Border>
<Border Grid.Row="2" Grid.Column="7" Style="{StaticResource TxGroupHeaderCell}"><TextBlock Text="측정" Style="{StaticResource ChannelMetricLabelText}"/></Border>
<Border Grid.Row="2" Grid.Column="8" Style="{StaticResource TxGroupHeaderCell}"><TextBlock Text="점검" Style="{StaticResource ChannelMetricLabelText}"/></Border>
<Border Grid.Row="2" Grid.Column="9" Style="{StaticResource TxGroupHeaderCell}"><TextBlock Text="최소" Style="{StaticResource ChannelMetricLabelText}"/></Border>
<Border Grid.Row="2" Grid.Column="10" Style="{StaticResource TxGroupHeaderCell}"><TextBlock Text="표준" Style="{StaticResource ChannelMetricLabelText}"/></Border>
<Border Grid.Row="2" Grid.Column="11" Style="{StaticResource TxGroupHeaderCell}"><TextBlock Text="측정" Style="{StaticResource ChannelMetricLabelText}"/></Border>
<Border Grid.Row="2" Grid.Column="12" Style="{StaticResource TxGroupHeaderCell}"><TextBlock Text="점검" Style="{StaticResource ChannelMetricLabelText}"/></Border>
<Border Grid.Row="2" Grid.Column="13" Style="{StaticResource TxGroupHeaderCell}"><TextBlock Text="최소" Style="{StaticResource ChannelMetricLabelText}"/></Border>
<Border Grid.Row="2" Grid.Column="14" Style="{StaticResource RxGroupHeaderCell}"><TextBlock Text="표준" Style="{StaticResource ChannelMetricLabelText}"/></Border>
<Border Grid.Row="2" Grid.Column="15" Style="{StaticResource RxGroupHeaderCell}"><TextBlock Text="측정" Style="{StaticResource ChannelMetricLabelText}"/></Border>
<Border Grid.Row="2" Grid.Column="16" Style="{StaticResource RxGroupHeaderCell}"><TextBlock Text="점검" Style="{StaticResource ChannelMetricLabelText}"/></Border>
<Border Grid.Row="2" Grid.Column="17" Style="{StaticResource RxGroupHeaderCell}"><TextBlock Text="최소" Style="{StaticResource ChannelMetricLabelText}"/></Border>
<Border Grid.Row="2" Grid.Column="18" Style="{StaticResource RxGroupHeaderCell}"><TextBlock Text="표준" Style="{StaticResource ChannelMetricLabelText}"/></Border>
<Border Grid.Row="2" Grid.Column="19" Style="{StaticResource RxGroupHeaderCell}"><TextBlock Text="측정" Style="{StaticResource ChannelMetricLabelText}"/></Border>
<Border Grid.Row="2" Grid.Column="20" Style="{StaticResource RxGroupHeaderCell}"><TextBlock Text="점검" Style="{StaticResource ChannelMetricLabelText}"/></Border>
<Border Grid.Row="2" Grid.Column="21" Style="{StaticResource RxGroupHeaderCell}"><TextBlock Text="최소" Style="{StaticResource ChannelMetricLabelText}"/></Border>
<Border Grid.Row="2" Grid.Column="22" Style="{StaticResource RxGroupHeaderCell}"><TextBlock Text="표준" Style="{StaticResource ChannelMetricLabelText}"/></Border>
<Border Grid.Row="2" Grid.Column="23" Style="{StaticResource RxGroupHeaderCell}"><TextBlock Text="측정" Style="{StaticResource ChannelMetricLabelText}"/></Border>
<Border Grid.Row="2" Grid.Column="24" Style="{StaticResource RxGroupHeaderCell}"><TextBlock Text="점검" Style="{StaticResource ChannelMetricLabelText}"/></Border>
<Border Grid.Row="2" Grid.Column="25" Style="{StaticResource RxGroupHeaderCell}"><TextBlock Text="최소" Style="{StaticResource ChannelMetricLabelText}"/></Border>
                    </Grid>
                </ScrollViewer>

                <DataGrid Grid.Row="1" x:Name="MainGrid" ItemsSource="{Binding Results}" BorderThickness="0" HeadersVisibility="None"
                              CanUserResizeColumns="False"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.ScrollChanged="MainGrid_ScrollChanged"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True">
                        <DataGrid.Columns>
<DataGridTextColumn Binding="{Binding TrackName}" Width="120"/>
<DataGridTextColumn Binding="{Binding TimeLabel}" Width="90"/>
<DataGridTextColumn Binding="{Binding TRK_FREQ.Standard, StringFormat=F2}" Width="80"/>
<DataGridTextColumn Binding="{Binding TRK_FREQ.Measured, StringFormat=F2}" Width="80"/>
<DataGridTextColumn Binding="{Binding TRK_FREQ.Checked, StringFormat=F2}" Width="80"/>
<DataGridTextColumn Binding="{Binding TRK_FREQ.Minimum, StringFormat=F2}" Width="80"/>
<DataGridTextColumn Binding="{Binding CAB_FREQ.Standard, StringFormat=F2}" Width="80"/>
<DataGridTextColumn Binding="{Binding CAB_FREQ.Measured, StringFormat=F2}" Width="80"/>
<DataGridTextColumn Binding="{Binding CAB_FREQ.Checked, StringFormat=F2}" Width="80"/>
<DataGridTextColumn Binding="{Binding CAB_FREQ.Minimum, StringFormat=F2}" Width="80"/>
<DataGridTextColumn Binding="{Binding CODE_FREQ.Standard, StringFormat=F2}" Width="80"/>
<DataGridTextColumn Binding="{Binding CODE_FREQ.Measured, StringFormat=F2}" Width="80"/>
<DataGridTextColumn Binding="{Binding CODE_FREQ.Checked, StringFormat=F2}" Width="80"/>
<DataGridTextColumn Binding="{Binding CODE_FREQ.Minimum, StringFormat=F2}" Width="80"/>
<DataGridTextColumn Binding="{Binding TX_VOLTAGE.Standard, StringFormat=F1}" Width="80"/>
<DataGridTextColumn Binding="{Binding TX_VOLTAGE.Measured, StringFormat=F1}" Width="80"/>
<DataGridTextColumn Binding="{Binding TX_VOLTAGE.Checked, StringFormat=F1}" Width="80"/>
<DataGridTextColumn Binding="{Binding TX_VOLTAGE.Minimum, StringFormat=F1}" Width="80"/>
<DataGridTextColumn Binding="{Binding RX_A_VOLTAGE.Standard, StringFormat=F1}" Width="80"/>
<DataGridTextColumn Binding="{Binding RX_A_VOLTAGE.Measured, StringFormat=F1}" Width="80"/>
<DataGridTextColumn Binding="{Binding RX_A_VOLTAGE.Checked, StringFormat=F1}" Width="80"/>
<DataGridTextColumn Binding="{Binding RX_A_VOLTAGE.Minimum, StringFormat=F1}" Width="80"/>
<DataGridTextColumn Binding="{Binding RX_B_VOLTAGE.Standard, StringFormat=F1}" Width="80"/>
<DataGridTextColumn Binding="{Binding RX_B_VOLTAGE.Measured, StringFormat=F1}" Width="80"/>
<DataGridTextColumn Binding="{Binding RX_B_VOLTAGE.Checked, StringFormat=F1}" Width="80"/>
<DataGridTextColumn Binding="{Binding RX_B_VOLTAGE.Minimum, StringFormat=F1}" Width="80"/>
                        </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="1" Style="{StaticResource EmptyStateText}" Text="조회 결과가 없습니다.&#x0a;기간과 조건을 선택한 뒤 [조회]를 눌러주세요."
                           Visibility="{Binding Results.Count, Converter={StaticResource ZeroToVisibilityConverter}}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="TLDSDashBoard.Views.GraphPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:TLDSDashBoard.Views"
             xmlns:models="clr-namespace:TLDSDashBoard.Models"
             mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>

            <!-- Filter bar: 기간 + 장치(궤도) 선택 -->
            <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,20">
                <WrapPanel Orientation="Horizontal">
                    <TextBlock Text="기간" Style="{StaticResource FilterLabel}"/>
                    <views:DateRangeFilterView Filter="{Binding GraphRange}" Margin="0,0,20,6"/>

                    <TextBlock Text="장치" Style="{StaticResource FilterLabel}"/>
                    <ComboBox ItemsSource="{Binding AvailableTracks}" SelectedItem="{Binding SelectedTrack}"
                              ItemTemplate="{StaticResource NameItemTemplate}" Margin="0,0,20,6"/>

                    <Button Style="{StaticResource FilterActionButton}" Command="{Binding GraphSearchCommand}" Margin="0,0,0,6">
                        <TextBlock Text="조회"/>
                    </Button>
                </WrapPanel>
            </Border>

            <views:MetricGroupView Data="{Binding TxChart}" Margin="0,20,0,0"/>
            <views:MetricGroupView Data="{Binding RxChart}" Margin="0,20,0,0"/>

            <!-- Alarms scoped to the SAME 10-minute window as the charts above, not an unrelated fixed log. -->
            <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="최근 10분 알람" Style="{StaticResource SectionTitle}" Padding="18,14"/>
                    <Rectangle Height="1" Fill="{StaticResource BorderBrush1}"/>

                    <Grid Margin="18,8,18,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Time" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="Channel" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="2" Text="Message" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="3" Text="Severity" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding RecentAlarms}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:AlarmEventModel}">
                                <Border BorderBrush="{StaticResource BorderBrush1}" BorderThickness="0,1,0,0">
                                    <Grid Margin="18,9,18,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Time}" FontFamily="{StaticResource MonoFont}"
                                                   FontSize="12.5" Foreground="#FFA6ACB6"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Channel}" FontSize="12.5"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="12.5"
                                                   Foreground="#FFD9DBDD" TextTrimming="CharacterEllipsis"/>
                                        <Border Grid.Column="3" HorizontalAlignment="Left" CornerRadius="6" Padding="9,3"
                                                Background="{Binding Severity, Converter={StaticResource SeverityToBrushConverter}, ConverterParameter=Bg}">
                                            <TextBlock Text="{Binding SeverityLabel}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{Binding Severity, Converter={StaticResource SeverityToBrushConverter}, ConverterParameter=Fg}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>

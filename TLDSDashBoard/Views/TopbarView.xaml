<UserControl x:Class="TLDSDashBoard.Views.TopbarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="70">

    <Border BorderBrush="{StaticResource BorderBrush1}" BorderThickness="0,0,0,1" Padding="28,16">
        <DockPanel LastChildFill="False">

            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="그래프 대시보드" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding ClockLabel}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                           Foreground="{StaticResource TextDimBrush}" Margin="0,2,0,0"/>
                <TextBlock Text="{Binding DataSourceLabel}" FontSize="11"
                           Foreground="{StaticResource TextDimBrush}" Margin="0,2,0,0"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">

                <!-- Export -->
                <Grid>
                    <Button x:Name="ExportButton" Command="{Binding ToggleExportCommand}" Cursor="Hand"
                            Background="{StaticResource ExportBtnBgBrush}" BorderBrush="{StaticResource ExportBtnBorderBrush}"
                            BorderThickness="1" Foreground="{StaticResource ExportBtnTextBrush}" FontSize="12.5" Padding="12,7">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Export" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}"/>
                                        <TextBlock Text="▾" Foreground="{TemplateBinding Foreground}" FontSize="9" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Popup PlacementTarget="{Binding ElementName=ExportButton}" Placement="Bottom" VerticalOffset="6"
                           IsOpen="{Binding ExportOpen, Mode=OneWay}" StaysOpen="True" AllowsTransparency="True">
                        <Border Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="6" MinWidth="150">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Opacity="0.5" BlurRadius="28" ShadowDepth="6" Direction="270"/>
                            </Border.Effect>
                            <StackPanel>
                                <Button Style="{StaticResource FlatButton}" Command="{Binding ExportPngCommand}"
                                        HorizontalContentAlignment="Left" Padding="10,8">
                                    <TextBlock Text="Export as PNG" FontSize="12.5"/>
                                </Button>
                                <Button Style="{StaticResource FlatButton}" Command="{Binding ExportCsvCommand}"
                                        HorizontalContentAlignment="Left" Padding="10,8">
                                    <TextBlock Text="Export as CSV" FontSize="12.5"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>

<UserControl x:Class="TLDSDashBoard.Views.HourlyStatusModalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:TLDSDashBoard.Views"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="CategoryItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PanelHoverBgBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PanelHoverBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 조건 칩: 켜짐(IsChecked)이면 초록 점/테두리, 꺼짐이면 회색으로 흐려진다. 템플릿 안의
             {Binding Label}은 ToggleButton의 DataContext(= HourlyStatusConditionOption)에서 읽는다.
             색은 뷰모델이 브러시를 들고 있지 않고 트리거로 바꾼다. -->
        <Style x:Key="ConditionChip" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="{StaticResource BorderBrush1}"
                                BorderThickness="1" CornerRadius="14" Padding="12,5">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="Dot" Width="8" Height="8" VerticalAlignment="Center" Fill="{StaticResource TextDimBrush}"/>
                                <TextBlock x:Name="Lbl" Text="{Binding Label}" Margin="8,0,0,0" VerticalAlignment="Center"
                                           FontSize="12" Foreground="{StaticResource TextDimBrush}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PanelHoverBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SuccessBgBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
                                <Setter TargetName="Dot" Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                <Setter TargetName="Lbl" Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- DataContext를 UserControl 루트가 아니라 여기서 재정의한다 — 같은 패턴은 MetricGroupView 참고. -->
    <Grid x:Name="Overlay" DataContext="{Binding HourlyStatus}" Background="{StaticResource OverlayDimBrush}"
          Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibilityConverter}}"
          MouseLeftButtonDown="Overlay_MouseLeftButtonDown">
        <Border Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderLightBrush}"
                BorderThickness="1" CornerRadius="14" Width="1240" Height="700"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                MouseLeftButtonDown="Card_MouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.5" BlurRadius="32" ShadowDepth="8" Direction="270"/>
            </Border.Effect>

            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,14">
                    <TextBlock DockPanel.Dock="Left" Text="시간별 상태 출력" Style="{StaticResource SectionTitle}" FontSize="16"/>
                    <TextBlock DockPanel.Dock="Right" Text="✕" FontSize="16" Cursor="Hand"
                               Foreground="{StaticResource TextSecondaryBrush}" Padding="8,2"
                               MouseLeftButtonUp="CloseButton_MouseLeftButtonUp"/>
                </DockPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 카테고리는 다시 따로 나뉘어 있지만, 조회가 7개를 한꺼번에 읽는다(VM의 Search()). 그래서 여기서
                         다른 카테고리를 클릭하면 이미 읽어 둔 어느 그리드를 보여줄지(SelectedGroup)만 바뀌고
                         다시 조회하지 않는다. -->
                    <ListBox Grid.Column="0" ItemsSource="{Binding CategoryGroups}" SelectedItem="{Binding SelectedGroup}"
                              DisplayMemberPath="Label" Background="Transparent" BorderThickness="0"
                              ItemContainerStyle="{StaticResource CategoryItem}" Margin="0,0,16,0"/>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 필터(기간/역) — 동작 버튼(조회/CSV 저장/인쇄/닫기)은 검색 조건 체크박스 아래 줄로 옮겼다(아래 참고). -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="검색 기간" Style="{StaticResource FilterLabel}"/>
                                <views:DateRangeFilterView Filter="{Binding Range}" Margin="0,0,20,6"/>

                                <TextBlock Text="역 선택" Style="{StaticResource FilterLabel}"/>
                                <ComboBox ItemsSource="{Binding Stations}" SelectedItem="{Binding SelectedStation}"
                                          ItemTemplate="{StaticResource NameItemTemplate}" Margin="0,0,0,6"/>
                            </WrapPanel>
                        </StackPanel>

                        <!-- 조건 체크박스 — 7개 카테고리가 공유하는 고정된 한 줄이 아니라 카테고리별(SelectedGroup.ConditionOptions)이다.
                             각 그룹의 구성과 키워드는 HourlyStatusViewModel.ConditionDefs에 정의되어 있고 Search()가 필터로
                             적용한다. -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,12">
                            <ItemsControl ItemsSource="{Binding SelectedGroup.ConditionOptions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                                            <ToggleButton Style="{StaticResource ConditionChip}" IsChecked="{Binding IsChecked}" VerticalAlignment="Center"/>
                                            <!-- Only the 신호설비 이벤트 conditions have DeviceChoices (궤도/신호기/선로전환기 명칭). -->
                                            <ComboBox ItemsSource="{Binding DeviceChoices}" SelectedItem="{Binding SelectedDevice}"
                                                      IsEnabled="{Binding IsChecked}" MinWidth="90" Margin="8,0,0,0"
                                                      Visibility="{Binding HasDeviceChoices, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <CheckBox Content="다음 시간대 제외" IsChecked="{Binding ExcludeHourRange}" Margin="0,0,10,0"/>
                                <ComboBox ItemsSource="{Binding HourChoices}" SelectedItem="{Binding ExcludeFromHour}"
                                          IsEnabled="{Binding ExcludeHourRange}" Margin="0,0,6,0" MinWidth="60">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StringFormat=00}" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="~" Style="{StaticResource FilterLabel}"/>
                                <ComboBox ItemsSource="{Binding HourChoices}" SelectedItem="{Binding ExcludeToHour}"
                                          IsEnabled="{Binding ExcludeHourRange}" MinWidth="60">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StringFormat=00}" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <!-- 동작 버튼 줄 — 검색 조건(체크박스, 시간대 제외) 바로 아래, 결과 표 바로 위. 버튼 묶음이
                                 어정쩡하게 중간에서 줄바꿈되며 갈라지지 않도록 필터와 따로 한 줄로 둔다. -->
                            <WrapPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Style="{StaticResource FilterActionButton}" Command="{Binding SearchCommand}" Margin="0,0,8,0">
                                    <TextBlock Text="조회"/>
                                </Button>
                                <Button Style="{StaticResource FilterActionButton}" Command="{Binding ExportCsvCommand}" Margin="0,0,8,0">
                                    <TextBlock Text="CSV 저장"/>
                                </Button>
                                <Button Style="{StaticResource FilterActionButton}" Command="{Binding PrintCommand}" Margin="0,0,8,0">
                                    <TextBlock Text="인쇄"/>
                                </Button>
                                <Button Style="{StaticResource FilterActionButton}" Command="{Binding CloseCommand}">
                                    <TextBlock Text="닫기"/>
                                </Button>
                            </WrapPanel>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Style="{StaticResource HintText}" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <Run Text="{Binding SelectedGroup.Label, Mode=OneWay}"/><Run Text=" "/>
                            <Run Text="{Binding SelectedGroup.Rows.Count, Mode=OneWay}"/><Run Text="건 · 전체 "/>
                            <Run Text="{Binding StatusMessage, Mode=OneWay}"/>
                        </TextBlock>

                        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                            <Grid>
                                <DataGrid ItemsSource="{Binding SelectedGroup.Rows}" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="발생시각" Binding="{Binding OccurredAt}" Width="160"/>
                                        <DataGridTextColumn Header="역 명칭" Binding="{Binding StationName}" Width="140"/>
                                        <DataGridTextColumn Header="장치이름" Binding="{Binding DeviceName}" Width="140"/>
                                        <DataGridTextColumn Header="내용" Binding="{Binding Content}" Width="*">
                                            <DataGridTextColumn.CellStyle>
                                                <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                                    <Setter Property="Padding" Value="12,0"/>
                                                </Style>
                                            </DataGridTextColumn.CellStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Style="{StaticResource EmptyStateText}" Text="조회 결과가 없습니다.&#x0a;검색 기간과 역을 선택한 뒤 [조회]를 눌러주세요."
                                           Visibility="{Binding SelectedGroup.Rows.Count, Converter={StaticResource ZeroToVisibilityConverter}}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>

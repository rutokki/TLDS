<UserControl x:Class="TLDSDashBoard.Views.MetricGroupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             x:Name="Root"
             mc:Ignorable="d" d:DesignHeight="600">

    <UserControl.Resources>
        <!-- Left label for one lane: color dot + name (top), big current/hovered value (middle), id (bottom).
             Click opens the drill-in modal for that one channel (its own full-history chart + min/max/avg). -->
        <Style x:Key="LaneLabelButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <!-- Must match the lane chart Border's Height on the right (and ChartMetrics.LaneChartH) so the two columns' rows line up. -->
            <Setter Property="Height" Value="90"/>
            <Setter Property="Command" Value="{Binding DataContext.OpenDrillCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            <Setter Property="CommandParameter" Value="{Binding Id}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="{StaticResource BorderBrush1}"
                                BorderThickness="0,0,1,1" Padding="6,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0"
                                             Fill="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"/>
                                    <TextBlock Text="{Binding Name}" FontSize="11.5" Foreground="#FFBFC5CE"/>
                                </StackPanel>

                                <TextBlock Grid.Row="1" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}"
                                           FontSize="16" FontWeight="SemiBold">
                                    <Run Text="{Binding Value, Mode=OneWay}"/>
                                    <Run Text="{Binding Unit, Mode=OneWay}" FontSize="10.5" FontWeight="Normal" Foreground="{StaticResource TextDimBrush}"/>
                                </TextBlock>

                                <TextBlock Grid.Row="2" Text="{Binding Id}" FontSize="9.5" FontFamily="{StaticResource MonoFont}"
                                           Foreground="{StaticResource TextDimBrush}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PanelHoverBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel DataContext="{Binding ElementName=Root}">
        <TextBlock Text="{Binding Data.Header}" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>

        <Border Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrush1}"
                BorderThickness="1" CornerRadius="10" Padding="16,14">
            <StackPanel>

                <!-- One stacked lane per channel — each with its OWN real value axis (not normalized/overlaid,
                     since units differ: V/A/Hz/ms). A single crosshair + hover-time chip spans the whole stack
                     (see ChartArea_MouseMove/Leave in code-behind), updating every lane's value together. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: name / current-or-hovered value / id, one row per channel -->
                    <ItemsControl Grid.Column="0" ItemsSource="{Binding Data.Series}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource LaneLabelButtonStyle}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Right: one mini-chart per channel, stacked, each with its own top(max)/bottom(min) axis labels -->
                    <Grid Grid.Column="1">
                        <ItemsControl ItemsSource="{Binding Data.Series}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Height="90" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Viewbox Stretch="Fill">
                                                <Canvas Width="900" Height="90">
                                                    <Path Data="{Binding Path, Converter={StaticResource PathDataConverter}}"
                                                          Stroke="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                          StrokeThickness="2"/>
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock Text="{Binding AxisMaxLabel}" FontSize="9" FontFamily="{StaticResource MonoFont}"
                                                       Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Right"
                                                       VerticalAlignment="Top" Margin="0,2,4,0"/>
                                            <TextBlock Text="{Binding AxisMinLabel}" FontSize="9" FontFamily="{StaticResource MonoFont}"
                                                       Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Right"
                                                       VerticalAlignment="Bottom" Margin="0,0,4,2"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Shared hover overlay: transparent so it captures the mouse across the whole stack,
                             stretches to the same size as the ItemsControl above it (same Grid cell). -->
                        <Grid x:Name="ChartArea" Background="Transparent"
                              MouseMove="ChartArea_MouseMove" MouseLeave="ChartArea_MouseLeave">
                            <Line x:Name="CrosshairLine" Y1="0" Stroke="{StaticResource BorderLightBrush}"
                                  StrokeThickness="1" StrokeDashArray="3,2" Visibility="Collapsed" IsHitTestVisible="False"/>

                            <Border Visibility="{Binding Data.HoverTimeLabel, Converter={StaticResource NullToVisibilityConverter}}"
                                    Background="{StaticResource PanelHoverBgBrush}" BorderBrush="{StaticResource BorderLightBrush}"
                                    BorderThickness="1" CornerRadius="5" Padding="6,3" Margin="6"
                                    HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
                                <TextBlock Text="{Binding Data.HoverTimeLabel}" FontSize="10.5" FontFamily="{StaticResource MonoFont}"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Shared time axis, indented to align under the chart column -->
                <Grid Margin="120,4,0,0">
                    <TextBlock Text="{Binding Data.TimeStartLabel}" FontSize="9.5" FontFamily="{StaticResource MonoFont}"
                               Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding Data.TimeMidLabel}" FontSize="9.5" FontFamily="{StaticResource MonoFont}"
                               Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Data.TimeEndLabel}" FontSize="9.5" FontFamily="{StaticResource MonoFont}"
                               Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Right"/>
                </Grid>

            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>

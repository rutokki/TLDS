<UserControl x:Class="TLDSDashBoard.Views.TrackVoltageListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- 상단 점검/최소 % 입력칸. -->
        <Style x:Key="PctBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BgBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Width" Value="58"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <EventSetter Event="KeyDown" Handler="PctBox_KeyDown"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource InfoTextBrush}"/>
                </Trigger>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource CriticalBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 항목 칩: 켜짐(IsChecked)이면 초록 점/테두리, 꺼짐이면 회색으로 흐려진다(시간별 상태 출력의 조건 칩과 같은 모양).
             글자는 ToggleButton의 Content. 켜져 있는 항목만 [전체 적용]으로 수정된다. -->
        <Style x:Key="ChannelChip" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="0,0,8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="{StaticResource BorderBrush1}"
                                BorderThickness="1" CornerRadius="14" Padding="12,5">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="Dot" Width="8" Height="8" VerticalAlignment="Center" Fill="{StaticResource TextDimBrush}"/>
                                <TextBlock x:Name="Lbl" Text="{TemplateBinding Content}" Margin="8,0,0,0" VerticalAlignment="Center"
                                           FontSize="12" Foreground="{StaticResource TextDimBrush}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PanelHoverBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SuccessBgBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
                                <Setter TargetName="Dot" Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                <Setter TargetName="Lbl" Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Pending0" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Cells[0].IsDirty}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource WarningTextBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Pending1" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Cells[1].IsDirty}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource WarningTextBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Pending2" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Cells[2].IsDirty}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource WarningTextBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Pending3" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Cells[3].IsDirty}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource WarningTextBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Pending4" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Cells[4].IsDirty}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource WarningTextBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Pending5" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Cells[5].IsDirty}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource WarningTextBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- DataContext를 UserControl 루트가 아니라 여기서 재정의해서, 바깥(MainViewModel에 대한)에서 지정한
         Visibility 바인딩이 계속 동작하게 한다 — 같은 패턴은 TrackFaultListView 참고. -->
    <Grid DataContext="{Binding TrackVoltageList}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 필터/저장 바 -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,16">
            <StackPanel>
                <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="역" Style="{StaticResource FilterLabel}"/>
                    <ComboBox ItemsSource="{Binding Stations}" SelectedItem="{Binding SelectedStation}"
                              ItemTemplate="{StaticResource NameItemTemplate}" Margin="0,0,24,6"/>

                    <!-- % 를 정하는 유일한 입력(정수) — [전체 적용]이 아래 칩이 켜진 항목에 현재 측정값의 이 %를 적용한다.
                         SetValue.db에 행이 없는 궤도도 현재 측정값이 있으면 포함된다. -->
                    <TextBlock Text="점검" Style="{StaticResource FilterLabel}"/>
                    <TextBox Style="{StaticResource PctBox}" Margin="0,0,2,6"
                             Text="{Binding BulkCautionPct, UpdateSourceTrigger=LostFocus}"/>
                    <TextBlock Text="%" Style="{StaticResource FilterLabel}" Margin="0,0,12,0"/>
                    <TextBlock Text="최소" Style="{StaticResource FilterLabel}"/>
                    <TextBox Style="{StaticResource PctBox}" Margin="0,0,2,6"
                             Text="{Binding BulkWarningPct, UpdateSourceTrigger=LostFocus}"/>
                    <TextBlock Text="%" Style="{StaticResource FilterLabel}" Margin="0,0,12,0"/>
                    <Button Style="{StaticResource FilterActionButton}" Command="{Binding ApplyAllCommand}" Margin="0,0,0,6">
                        <TextBlock Text="전체 적용"/>
                    </Button>
                </WrapPanel>

                <!-- 항목 칩 — 켜져 있는(초록) 항목만 [전체 적용]으로 수정된다. "전체" 칩은 6개 항목을 한꺼번에 켜고 끈다. -->
                <WrapPanel Orientation="Horizontal" Margin="0,0,0,2">
                    <TextBlock Text="수정 항목" Style="{StaticResource FilterLabel}" Margin="0,0,10,6"/>
                    <ToggleButton Style="{StaticResource ChannelChip}" Content="전체" IsChecked="{Binding AllChannelsOn, Mode=TwoWay}"/>
                    <ItemsControl ItemsSource="{Binding ChannelChips}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Style="{StaticResource ChannelChip}" Content="{Binding Name}" IsChecked="{Binding IsOn, Mode=TwoWay}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </WrapPanel>

                <WrapPanel Orientation="Horizontal">
                    <Button Style="{StaticResource FilterActionButton}" Command="{Binding SaveCommand}" Margin="0,0,8,0">
                        <TextBlock Text="저장"/>
                    </Button>
                    <Button Style="{StaticResource FilterActionButton}" Command="{Binding ReloadCommand}" Margin="0,0,8,0">
                        <TextBlock Text="불러오기"/>
                    </Button>
                    <!-- 테스트 전용: 읽기 처리를 시험할 샘플 데이터를 공유메모리에 만든다. Debug 빌드에서만 보이고
                         Release(실제 배포)에서는 IsSharedMemoryTestVisible이 false라 나타나지 않는다. -->
                    <Button Style="{StaticResource FilterActionButton}" Command="{Binding SaveSharedMemoryCommand}" Margin="0,0,8,0"
                            Visibility="{Binding IsSharedMemoryTestVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="공유메모리 저장 (테스트)"/>
                    </Button>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding MeasureStatus}" Style="{StaticResource HintText}" VerticalAlignment="Center"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- 측정 표(6항목 × 기준/측정/점검/최소 = 24컬럼, 읽기 전용). 병합 헤더 구조와 스크롤 동기화는 TrackFaultListView와 같다(자세한
             이유는 거기 주석 참고): DataGrid 자체 헤더는 숨기고, 컬럼 폭과 픽셀 단위로 일치하는 Grid를 가로 전용 ScrollViewer 안에
             두며, DataGrid는 자기 스크롤(+UI 가상화)을 유지한다. 적용만 하고 아직 저장하지 않은 항목의 기준/점검/최소는 황색 글자다. -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" x:Name="HeaderScroll" HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled" IsHitTestVisible="False">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <!-- 궤도 주파수: 기준/측정/점검/최소 -->
                            <ColumnDefinition Width="70"/><ColumnDefinition Width="70"/><ColumnDefinition Width="70"/><ColumnDefinition Width="70"/>
                            <!-- 차상 주파수: 기준/측정/점검/최소 -->
                            <ColumnDefinition Width="70"/><ColumnDefinition Width="70"/><ColumnDefinition Width="70"/><ColumnDefinition Width="70"/>
                            <!-- 지상 주파수: 기준/측정/점검/최소 -->
                            <ColumnDefinition Width="70"/><ColumnDefinition Width="70"/><ColumnDefinition Width="70"/><ColumnDefinition Width="70"/>
                            <!-- 송신 전압: 기준/측정/점검/최소 -->
                            <ColumnDefinition Width="70"/><ColumnDefinition Width="70"/><ColumnDefinition Width="70"/><ColumnDefinition Width="70"/>
                            <!-- 수신 A 전압: 기준/측정/점검/최소 -->
                            <ColumnDefinition Width="70"/><ColumnDefinition Width="70"/><ColumnDefinition Width="70"/><ColumnDefinition Width="70"/>
                            <!-- 수신 B 전압: 기준/측정/점검/최소 -->
                            <ColumnDefinition Width="70"/><ColumnDefinition Width="70"/><ColumnDefinition Width="70"/><ColumnDefinition Width="70"/>
                            <!-- 스페이서 = DataGrid 세로 스크롤바 폭(Styles.xaml ScrollBar Width=10) -->
                            <ColumnDefinition Width="10"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Grid.RowSpan="3" Style="{StaticResource GroupHeaderCell}"><TextBlock Text="궤도명칭" Style="{StaticResource ChannelMetricLabelText}"/></Border>

                        <!-- 1단: 주파수/전압 그룹 병합 -->
                        <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="12" Style="{StaticResource TxGroupHeaderCell}"><TextBlock Text="주파수" Style="{StaticResource ChannelGroupLabelText}"/></Border>
                        <Border Grid.Row="0" Grid.Column="13" Grid.ColumnSpan="12" Style="{StaticResource RxGroupHeaderCell}"><TextBlock Text="전압" Style="{StaticResource ChannelGroupLabelText}"/></Border>

                        <!-- 2단: 항목명 병합 (4컬럼씩) -->
                        <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" Style="{StaticResource TxGroupHeaderCell}"><TextBlock Text="궤도 주파수" Style="{StaticResource ChannelNameLabelText}"/></Border>
                        <Border Grid.Row="1" Grid.Column="5" Grid.ColumnSpan="4" Style="{StaticResource TxGroupHeaderCell}"><TextBlock Text="차상 주파수" Style="{StaticResource ChannelNameLabelText}"/></Border>
                        <Border Grid.Row="1" Grid.Column="9" Grid.ColumnSpan="4" Style="{StaticResource TxGroupHeaderCell}"><TextBlock Text="지상 주파수" Style="{StaticResource ChannelNameLabelText}"/></Border>
                        <Border Grid.Row="1" Grid.Column="13" Grid.ColumnSpan="4" Style="{StaticResource RxGroupHeaderCell}"><TextBlock Text="송신 전압" Style="{StaticResource ChannelNameLabelText}"/></Border>
                        <Border Grid.Row="1" Grid.Column="17" Grid.ColumnSpan="4" Style="{StaticResource RxGroupHeaderCell}"><TextBlock Text="수신 A 전압" Style="{StaticResource ChannelNameLabelText}"/></Border>
                        <Border Grid.Row="1" Grid.Column="21" Grid.ColumnSpan="4" Style="{StaticResource RxGroupHeaderCell}"><TextBlock Text="수신 B 전압" Style="{StaticResource ChannelNameLabelText}"/></Border>

                        <!-- 3단: 기준/측정/점검/최소 개별 컬럼 -->
                        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource TxGroupHeaderCell}"><TextBlock Text="기준" Style="{StaticResource ChannelMetricLabelText}"/></Border>
                        <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource TxGroupHeaderCell}"><TextBlock Text="측정" Style="{StaticResource ChannelMetricLabelText}"/></Border>
                        <Border Grid.Row="2" Grid.Column="3" Style="{StaticResource TxGroupHeaderCell}"><TextBlock Text="점검" Style="{StaticResource ChannelMetricLabelText}"/></Border>
                        <Border Grid.Row="2" Grid.Column="4" Style="{StaticResource TxGroupHeaderCell}"><TextBlock Text="최소" Style="{StaticResource ChannelMetricLabelText}"/></Border>
                        <Border Grid.Row="2" Grid.Column="5" Style="{StaticResource TxGroupHeaderCell}"><TextBlock Text="기준" Style="{StaticResource ChannelMetricLabelText}"/></Border>
                        <Border Grid.Row="2" Grid.Column="6" Style="{StaticResource TxGroupHeaderCell}"><TextBlock Text="측정" Style="{StaticResource ChannelMetricLabelText}"/></Border>
                        <Border Grid.Row="2" Grid.Column="7" Style="{StaticResource TxGroupHeaderCell}"><TextBlock Text="점검" Style="{StaticResource ChannelMetricLabelText}"/></Border>
                        <Border Grid.Row="2" Grid.Column="8" Style="{StaticResource TxGroupHeaderCell}"><TextBlock Text="최소" Style="{StaticResource ChannelMetricLabelText}"/></Border>
                        <Border Grid.Row="2" Grid.Column="9" Style="{StaticResource TxGroupHeaderCell}"><TextBlock Text="기준" Style="{StaticResource ChannelMetricLabelText}"/></Border>
                        <Border Grid.Row="2" Grid.Column="10" Style="{StaticResource TxGroupHeaderCell}"><TextBlock Text="측정" Style="{StaticResource ChannelMetricLabelText}"/></Border>
                        <Border Grid.Row="2" Grid.Column="11" Style="{StaticResource TxGroupHeaderCell}"><TextBlock Text="점검" Style="{StaticResource ChannelMetricLabelText}"/></Border>
                        <Border Grid.Row="2" Grid.Column="12" Style="{StaticResource TxGroupHeaderCell}"><TextBlock Text="최소" Style="{StaticResource ChannelMetricLabelText}"/></Border>
                        <Border Grid.Row="2" Grid.Column="13" Style="{StaticResource RxGroupHeaderCell}"><TextBlock Text="기준" Style="{StaticResource ChannelMetricLabelText}"/></Border>
                        <Border Grid.Row="2" Grid.Column="14" Style="{StaticResource RxGroupHeaderCell}"><TextBlock Text="측정" Style="{StaticResource ChannelMetricLabelText}"/></Border>
                        <Border Grid.Row="2" Grid.Column="15" Style="{StaticResource RxGroupHeaderCell}"><TextBlock Text="점검" Style="{StaticResource ChannelMetricLabelText}"/></Border>
                        <Border Grid.Row="2" Grid.Column="16" Style="{StaticResource RxGroupHeaderCell}"><TextBlock Text="최소" Style="{StaticResource ChannelMetricLabelText}"/></Border>
                        <Border Grid.Row="2" Grid.Column="17" Style="{StaticResource RxGroupHeaderCell}"><TextBlock Text="기준" Style="{StaticResource ChannelMetricLabelText}"/></Border>
                        <Border Grid.Row="2" Grid.Column="18" Style="{StaticResource RxGroupHeaderCell}"><TextBlock Text="측정" Style="{StaticResource ChannelMetricLabelText}"/></Border>
                        <Border Grid.Row="2" Grid.Column="19" Style="{StaticResource RxGroupHeaderCell}"><TextBlock Text="점검" Style="{StaticResource ChannelMetricLabelText}"/></Border>
                        <Border Grid.Row="2" Grid.Column="20" Style="{StaticResource RxGroupHeaderCell}"><TextBlock Text="최소" Style="{StaticResource ChannelMetricLabelText}"/></Border>
                        <Border Grid.Row="2" Grid.Column="21" Style="{StaticResource RxGroupHeaderCell}"><TextBlock Text="기준" Style="{StaticResource ChannelMetricLabelText}"/></Border>
                        <Border Grid.Row="2" Grid.Column="22" Style="{StaticResource RxGroupHeaderCell}"><TextBlock Text="측정" Style="{StaticResource ChannelMetricLabelText}"/></Border>
                        <Border Grid.Row="2" Grid.Column="23" Style="{StaticResource RxGroupHeaderCell}"><TextBlock Text="점검" Style="{StaticResource ChannelMetricLabelText}"/></Border>
                        <Border Grid.Row="2" Grid.Column="24" Style="{StaticResource RxGroupHeaderCell}"><TextBlock Text="최소" Style="{StaticResource ChannelMetricLabelText}"/></Border>
                    </Grid>
                </ScrollViewer>

                <DataGrid Grid.Row="1" x:Name="MainGrid" ItemsSource="{Binding Rows}" BorderThickness="0" HeadersVisibility="None"
                          CanUserResizeColumns="False"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.ScrollChanged="MainGrid_ScrollChanged"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding TrackName}" Width="90"/>

                        <!-- 궤도 주파수 -->
                        <DataGridTextColumn Binding="{Binding Cells[0].Base, StringFormat=F0}" ElementStyle="{StaticResource Pending0}" Width="70"/>
                        <DataGridTextColumn Binding="{Binding Cells[0].Measured, StringFormat=F0}" Width="70"/>
                        <DataGridTextColumn Binding="{Binding Cells[0].Caution, StringFormat=F0}" ElementStyle="{StaticResource Pending0}" Width="70"/>
                        <DataGridTextColumn Binding="{Binding Cells[0].Minimum, StringFormat=F0}" ElementStyle="{StaticResource Pending0}" Width="70"/>

                        <!-- 차상 주파수 -->
                        <DataGridTextColumn Binding="{Binding Cells[1].Base, StringFormat=F0}" ElementStyle="{StaticResource Pending1}" Width="70"/>
                        <DataGridTextColumn Binding="{Binding Cells[1].Measured, StringFormat=F0}" Width="70"/>
                        <DataGridTextColumn Binding="{Binding Cells[1].Caution, StringFormat=F0}" ElementStyle="{StaticResource Pending1}" Width="70"/>
                        <DataGridTextColumn Binding="{Binding Cells[1].Minimum, StringFormat=F0}" ElementStyle="{StaticResource Pending1}" Width="70"/>

                        <!-- 지상 주파수 -->
                        <DataGridTextColumn Binding="{Binding Cells[2].Base, StringFormat=F2}" ElementStyle="{StaticResource Pending2}" Width="70"/>
                        <DataGridTextColumn Binding="{Binding Cells[2].Measured, StringFormat=F2}" Width="70"/>
                        <DataGridTextColumn Binding="{Binding Cells[2].Caution, StringFormat=F2}" ElementStyle="{StaticResource Pending2}" Width="70"/>
                        <DataGridTextColumn Binding="{Binding Cells[2].Minimum, StringFormat=F2}" ElementStyle="{StaticResource Pending2}" Width="70"/>

                        <!-- 송신 전압 -->
                        <DataGridTextColumn Binding="{Binding Cells[3].Base, StringFormat=F1}" ElementStyle="{StaticResource Pending3}" Width="70"/>
                        <DataGridTextColumn Binding="{Binding Cells[3].Measured, StringFormat=F1}" Width="70"/>
                        <DataGridTextColumn Binding="{Binding Cells[3].Caution, StringFormat=F1}" ElementStyle="{StaticResource Pending3}" Width="70"/>
                        <DataGridTextColumn Binding="{Binding Cells[3].Minimum, StringFormat=F1}" ElementStyle="{StaticResource Pending3}" Width="70"/>

                        <!-- 수신 A 전압 -->
                        <DataGridTextColumn Binding="{Binding Cells[4].Base, StringFormat=F2}" ElementStyle="{StaticResource Pending4}" Width="70"/>
                        <DataGridTextColumn Binding="{Binding Cells[4].Measured, StringFormat=F2}" Width="70"/>
                        <DataGridTextColumn Binding="{Binding Cells[4].Caution, StringFormat=F2}" ElementStyle="{StaticResource Pending4}" Width="70"/>
                        <DataGridTextColumn Binding="{Binding Cells[4].Minimum, StringFormat=F2}" ElementStyle="{StaticResource Pending4}" Width="70"/>

                        <!-- 수신 B 전압 -->
                        <DataGridTextColumn Binding="{Binding Cells[5].Base, StringFormat=F2}" ElementStyle="{StaticResource Pending5}" Width="70"/>
                        <DataGridTextColumn Binding="{Binding Cells[5].Measured, StringFormat=F2}" Width="70"/>
                        <DataGridTextColumn Binding="{Binding Cells[5].Caution, StringFormat=F2}" ElementStyle="{StaticResource Pending5}" Width="70"/>
                        <DataGridTextColumn Binding="{Binding Cells[5].Minimum, StringFormat=F2}" ElementStyle="{StaticResource Pending5}" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="1" Style="{StaticResource EmptyStateText}" Text="표시할 궤도가 없습니다.&#x0a;역을 선택하세요."
                           Visibility="{Binding Rows.Count, Converter={StaticResource ZeroToVisibilityConverter}}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>

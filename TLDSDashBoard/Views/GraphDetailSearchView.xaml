<UserControl x:Class="TLDSDashBoard.Views.GraphDetailSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:TLDSDashBoard.Views"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- 레인 하나의 왼쪽 라벨: 색 점 + 이름(위), 현재/호버 값(가운데), id(아래). MetricGroupView의 레인 라벨과
             시각적으로 같다. 높이는 고정값 대신 바인딩된 LaneHeight에서 오므로(코드비하인드의
             LanesScroll_SizeChanged 참고) 기본적으로 모든 레인이 한 화면에 딱 맞고, 세로 확대(vertical zoom)
             때 함께 커진다. -->
        <Style x:Key="DetailLaneLabelStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush1}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="6,8"/>
        </Style>

        <!-- 측정/점검선/세로확대 토글용 작은 켜기/끄기 칩 버튼 — 체크되면 테마의 "info" 강조색을 써서
             어두운 배경에서 분명히 읽힌다. -->
        <Style x:Key="ToggleChipButton" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PanelHoverBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource InfoBgBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource InfoTextBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource InfoTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- DataContext를 UserControl 루트가 아니라 여기서 재정의해서, 바깥(MainViewModel에 대한)에서 지정한
         Visibility 바인딩이 계속 동작하게 한다 — 같은 패턴은 MetricGroupView 참고.
         루트는 페이지 전체 ScrollViewer가 아니라 Grid(Auto 필터 행 + "*" 차트 카드 행)이므로, 차트 카드가 남은
         창 높이를 실제로 채우고 모든 레인이 기본적으로 한 화면에 들어갈 수 있다 — 페이지를 바깥
         ScrollViewer 안에 두지 않는 이유는 MainWindow.xaml의 주석 참고. -->
    <Grid x:Name="PageRoot" DataContext="{Binding GraphDetailSearch}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 필터(한 행) + 동작 버튼(한 행) — 왜 나눴는지는 다른 조회 페이지 참고. -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,20">
            <StackPanel>
                <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="기간" Style="{StaticResource FilterLabel}"/>
                    <views:DateRangeFilterView Filter="{Binding Range}" Margin="0,0,20,6"/>

                    <TextBlock Text="장치" Style="{StaticResource FilterLabel}"/>
                    <ComboBox ItemsSource="{Binding AvailableTracks}" SelectedItem="{Binding SelectedTrack}"
                              ItemTemplate="{StaticResource NameItemTemplate}" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding SelectedTrack.RackLabel}" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="10,0,0,6"/>
                </WrapPanel>

                <WrapPanel Orientation="Horizontal">
                    <Button Style="{StaticResource FilterActionButton}" Command="{Binding SearchCommand}" Margin="0,0,8,0">
                        <TextBlock Text="조회"/>
                    </Button>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource HintText}" VerticalAlignment="Center"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,10">
                    <TextBlock DockPanel.Dock="Left" Text="채널 상세 (주파수 3 · 전압 3, 기본 1시간)" Style="{StaticResource SectionTitle}"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <!-- 초기화 버튼을 카드 아래쪽이 아니라 여기 둔 이유: 마우스를 따라다니는 툴팁 Popup이 커서가
                             레인 아래쪽 근처에 있을 때마다 그 자리의 버튼을 계속 가렸기 때문이다 — 여기는 차트 영역에서 떨어져 있다. -->
                        <Button Style="{StaticResource FilterActionButton}" Command="{Binding ResetZoomCommand}" Margin="0,0,6,0">
                            <TextBlock Text="가로 줌 초기화"/>
                        </Button>
                        <Button Style="{StaticResource FilterActionButton}" Click="ResetLaneZoomButton_Click" Margin="0,0,14,0">
                            <TextBlock Text="세로 줌 초기화"/>
                        </Button>

                        <ToggleButton Style="{StaticResource ToggleChipButton}" IsChecked="{Binding ShowMeasuredLine}">
                            <TextBlock Text="측정선"/>
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource ToggleChipButton}" IsChecked="{Binding ShowReferenceLines}">
                            <TextBlock Text="점검 및 기준선 표시"/>
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource ToggleChipButton}" IsChecked="{Binding IsVerticalZoomMode}" Margin="0,0,14,0">
                            <TextBlock Text="세로 확대"/>
                        </ToggleButton>

                        <Rectangle Width="14" Height="2" Fill="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="측정" Style="{StaticResource LegendText}"/>
                        <Rectangle Width="14" Height="2" Fill="{StaticResource CheckedLineBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="점검" Style="{StaticResource LegendText}"/>
                        <Rectangle Width="14" Height="2" Fill="{StaticResource MinimumLineBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="최소" Style="{StaticResource LegendText}" Margin="5,0,0,0"/>
                    </StackPanel>
                    <!-- 사용 안내 문구를 붐비는 도구 모음 줄에서 아래쪽 줄(RangeLabel 옆)로 옮겼다. -->
                </DockPanel>

                <!-- 빈 상태: 이 페이지는 일부러 비어 있게 시작하므로(자동 조회 없음, 목 폴백 없음) 빈 카드를 보여주는
                     대신 그렇다고 알려준다. 조회로 레인이 반환되면 바로 숨겨진다. -->
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                            Visibility="{Binding Series.Count, Converter={StaticResource ZeroToVisibilityConverter}}">
                    <TextBlock Style="{StaticResource EmptyStateText}" Text="기간과 장치를 선택한 뒤 [조회]를 눌러주세요."/>
                    <TextBlock Style="{StaticResource EmptyStateText}" FontSize="11.5" Margin="0,6,0,0"
                               Text="실측 데이터(_file_log)가 있는 구간만 표시되며, 샘플 데이터로 대체하지 않습니다."/>
                </StackPanel>

                <!-- 레인이 이 행을 정확히 채우며(LaneHeight = 행 높이 / 채널 수) 기본적으로 스크롤이 필요 없다.
                     세로 확대는 LaneHeight를 그 이상으로 키우며, 이 ScrollViewer가 뷰포트보다 커진 레인 묶음을
                     실제로 스크롤할 수 있게 해준다. -->
                <ScrollViewer Grid.Row="1" x:Name="LanesScroll"
                              VerticalScrollBarVisibility="{Binding HasVerticalOverflow, Converter={StaticResource BoolToScrollBarVisibilityConverter}}"
                              HorizontalScrollBarVisibility="Disabled" SizeChanged="LanesScroll_SizeChanged">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 왼쪽: 이름 / 현재 또는 호버 값 / id, 채널당 한 행 -->
                        <ItemsControl Grid.Column="0" ItemsSource="{Binding Series}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource DetailLaneLabelStyle}"
                                            Height="{Binding DataContext.LaneHeight, ElementName=PageRoot}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0"
                                                         Fill="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"/>
                                                <TextBlock Text="{Binding Name}" FontSize="11.5" Foreground="#FFBFC5CE"/>
                                            </StackPanel>

                                            <TextBlock Grid.Row="1" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}"
                                                       FontSize="16" FontWeight="SemiBold">
                                                <Run Text="{Binding Value, Mode=OneWay}"/>
                                                <Run Text="{Binding Unit, Mode=OneWay}" FontSize="10.5" FontWeight="Normal" Foreground="{StaticResource TextDimBrush}"/>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 오른쪽: 채널당 차트 하나를 쌓아서, 각각 자신의 위(최대)/아래(최소) 축 라벨을 가진다 -->
                        <Grid Grid.Column="1">
                            <ItemsControl ItemsSource="{Binding Series}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Height="{Binding DataContext.LaneHeight, ElementName=PageRoot}"
                                                BorderBrush="{StaticResource BorderBrush1}" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Viewbox Stretch="Fill">
                                                    <Canvas Width="900" Height="90">
                                                        <Path Data="{Binding CheckedLinePath, Converter={StaticResource PathDataConverter}}"
                                                              Stroke="{StaticResource CheckedLineBrush}" StrokeThickness="1.75" StrokeDashArray="4,3"
                                                              Visibility="{Binding DataContext.ShowReferenceLines, ElementName=PageRoot, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        <Path Data="{Binding MinimumLinePath, Converter={StaticResource PathDataConverter}}"
                                                              Stroke="{StaticResource MinimumLineBrush}" StrokeThickness="1.75" StrokeDashArray="4,3"
                                                              Visibility="{Binding DataContext.ShowReferenceLines, ElementName=PageRoot, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        <Path Data="{Binding Path, Converter={StaticResource PathDataConverter}}"
                                                              Stroke="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                              StrokeThickness="2"
                                                              Visibility="{Binding DataContext.ShowMeasuredLine, ElementName=PageRoot, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    </Canvas>
                                                </Viewbox>
                                                <Border Style="{StaticResource LaneAxisLabelBox}" VerticalAlignment="Top" Margin="0,2,4,0">
                                                    <TextBlock Text="{Binding AxisMaxLabel}" Style="{StaticResource LaneAxisLabelText}"/>
                                                </Border>
                                                <Border Style="{StaticResource LaneAxisLabelBox}" VerticalAlignment="Bottom" Margin="0,0,4,2">
                                                    <TextBlock Text="{Binding AxisMinLabel}" Style="{StaticResource LaneAxisLabelText}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 공유 오버레이: 투명해서 쌓인 전체에 걸쳐 마우스를 받으며, 위의 ItemsControl과 같은 크기로
                                 늘어난다(같은 Grid 셀). MetricGroupView의 호버 전용 오버레이와 달리 이것은 줌/팬도 구동한다. -->
                            <Grid x:Name="ChartArea" Background="Transparent" Cursor="SizeWE"
                                  MouseMove="ChartArea_MouseMove" MouseLeave="ChartArea_MouseLeave"
                                  MouseWheel="ChartArea_MouseWheel"
                                  MouseLeftButtonDown="ChartArea_MouseLeftButtonDown"
                                  MouseLeftButtonUp="ChartArea_MouseLeftButtonUp">
                                <Line x:Name="CrosshairLine" Y1="0" Stroke="White"
                                      StrokeThickness="1" StrokeDashArray="3,2" Visibility="Collapsed" IsHitTestVisible="False"/>

                                <!-- 마우스를 따라다니는 툴팁을 일반 위치 지정 Border 대신 Popup(자체 최상위 창 레이어)으로 구현했다:
                                     Margin으로 옮기는 Border는 ChartArea가 히트 테스트하는 바로 그 비주얼 트리 안에 있으므로, 정지한
                                     커서 아래에서 옮기면 그 자체가 WPF의 합성 마우스 이동 재평가를 일으켜 다음 실제 MouseMove와
                                     충돌하고, 그것을 시도했을 때 바로 그 튀거나 멈추는 현상이 나타났다. Popup은 그 트리 밖에서
                                     그려지므로, 코드비하인드에서 HorizontalOffset/VerticalOffset으로 위치를 바꿔도 히트 테스트에
                                     되먹임될 수 없다. -->
                                <Popup x:Name="HoverTooltip" Placement="Relative" AllowsTransparency="True"
                                       IsHitTestVisible="False" Focusable="False" StaysOpen="True">
                                    <Border Background="{StaticResource PanelHoverBgBrush}" BorderBrush="{StaticResource BorderLightBrush}"
                                            BorderThickness="1" CornerRadius="6" Padding="10,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding HoverTimeLabel}" FontSize="13" FontFamily="{StaticResource MonoFont}"
                                                       Foreground="White" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                            <ItemsControl ItemsSource="{Binding Series}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="0,1">
                                                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0"
                                                                     Fill="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"/>
                                                            <TextBlock FontSize="10.5" FontFamily="{StaticResource MonoFont}">
                                                                <Run Text="{Binding Name, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                <Run Text=" : "/>
                                                                <Run Text="{Binding Value, Mode=OneWay}" FontWeight="SemiBold"/>
                                                                <Run Text="{Binding Unit, Mode=OneWay}" Foreground="{StaticResource TextDimBrush}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Grid>
                    </Grid>
                </ScrollViewer>

                <!-- 공유 시간축, 차트 컬럼 아래에 맞도록 들여씀 -->
                <Grid Grid.Row="2" Margin="120,4,0,0">
                    <TextBlock Text="{Binding TimeStartLabel}" FontSize="9.5" FontFamily="{StaticResource MonoFont}"
                               Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding TimeMidLabel}" FontSize="9.5" FontFamily="{StaticResource MonoFont}"
                               Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TimeEndLabel}" FontSize="9.5" FontFamily="{StaticResource MonoFont}"
                               Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Right"/>
                </Grid>

                <!-- 아래 행: 표시 중인 범위(왼쪽) + 창 크기 칩과 사용 안내(오른쪽). 창 크기 칩은 예전에 차트 오른쪽 위
                     모서리에 떠 있어서 레인 1의 최대 축 라벨을 가렸다. -->
                <DockPanel Grid.Row="3" LastChildFill="False" Margin="120,10,0,0">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding RangeLabel}" FontSize="11" Foreground="{StaticResource TextDimBrush}"
                               VerticalAlignment="Center"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Border Background="{StaticResource PanelHoverBgBrush}" BorderBrush="{StaticResource BorderLightBrush}"
                                BorderThickness="1" CornerRadius="5" Padding="6,2" Margin="0,0,12,0" VerticalAlignment="Center"
                                Visibility="{Binding WindowLabel, Converter={StaticResource NullToVisibilityConverter}}">
                            <TextBlock Text="{Binding WindowLabel}" FontSize="10.5" FontFamily="{StaticResource MonoFont}"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Border>
                        <TextBlock Text="휠: 확대·축소  ·  드래그: 이동  ·  [세로 확대] 켜고 휠: 레인 높이 조절" FontSize="11"
                                   Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
